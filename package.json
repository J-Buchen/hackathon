{
  "name": "allowance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Allowance — an attenuating-delegation protocol for autonomous AI-agent payments. Give your AI agents an allowance, not your wallet.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "demo": "tsx services/orchestrator/src/demo.ts",
    "snapshot": "npm run demo",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node --import tsx --test packages/core/src/attenuation.test.ts packages/core/src/tree.test.ts packages/core/src/payment.test.ts",
    "test:core": "npm -w @allowance/core run test",
    "dev:web": "npm -w allowance-web run dev",
    "build:web": "npm -w allowance-web run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
