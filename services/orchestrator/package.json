    "demo:swarm": "tsx src/swarm-demo.ts",
    "demo:agenthire": "tsx src/agenthire-demo.ts",
    "demo:fund": "tsx src/fund-demo.ts"
  },
  "dependencies": {
    "@allowance/core": "*",
    "@allowance/adapters": "*",
    "@allowance/lab": "*",
    "@allowance/swarm": "*"
  }
}
