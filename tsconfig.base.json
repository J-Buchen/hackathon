{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language / module system: ESM everywhere. */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    /* Project references: composite builds emit declarations + build info. */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Strictness — the whole monorepo is strict TypeScript. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    /* Interop / ergonomics. */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
