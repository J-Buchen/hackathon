+/** Connected components (size ≥ 2) of the graph on 0..n−1 with edges `linked(i, j)`, in input order. */
+function components(n: number, linked: (i: number, j: number) => boolean): number[][] {
+  const parent = Array.from({ length: n }, (_, i) => i);
+  const find = (i: number): number => {
+    while (parent[i] !== i) {
+      parent[i] = parent[parent[i]!]!;
+      i = parent[i]!;
+    }
+    return i;
+  };
+  for (let i = 0; i < n; i++) {
+    for (let j = i + 1; j < n; j++) if (linked(i, j)) parent[find(i)] = find(j);
+  }
+  const groups = new Map<number, number[]>();
+  for (let i = 0; i < n; i++) {
+    const root = find(i);
+    const g = groups.get(root);
+    if (g) g.push(i);
+    else groups.set(root, [i]);
+  }
+  return [...groups.values()].filter((g) => g.length >= 2);
