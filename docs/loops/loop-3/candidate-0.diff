+/* ------------------------------------------------------------------ */
+/* 4. Counterparties                                                  */
+/* ------------------------------------------------------------------ */
+
+export interface CounterpartyAgent {
+  name: string;
+  /** Who runs the agent; absent = a counterparty of its own. */
+  operator?: string;
+  ladder: LadderState;
+  /** The agent's own attributable record, oldest first. */
+  unitReturns: readonly number[];
