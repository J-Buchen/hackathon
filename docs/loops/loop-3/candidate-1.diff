+          assert.equal(o.authority, 0, `t=${t}: closed ${o.node} holds authority`);
+        } else {
+          assert.ok(o.authority <= usdc(available), `t=${t}: ${o.node} sized on ${o.authority} > available ${usdc(available)}`);
