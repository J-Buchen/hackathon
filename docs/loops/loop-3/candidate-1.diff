+          const byBudget = usdc(node.mandate.budget) * policy.leverage * weightGross;
+          if (byBudget > limit * (1 + 1e-6)) {
+            breaches++;
+            worst = Math.max(worst, byBudget - limit);
+          }
+        }
+        row.push({ authority: o.authority, notional: orderNotional(o), dead });
+      }
+      seen.push(row);
+    },
+  });
