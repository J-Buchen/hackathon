+    }
+    const available = toUsdc(tree.available(o.node));
+    if (gross > available * opts.leverage * (1 + TRADE_SLACK)) {
+      out.push(
+        `OVER_RESERVATION ${o.node}: gross notional ${gross.toFixed(2)} > available ${available.toFixed(2)} × leverage ${opts.leverage}`,
