+const tenurePolicy = { crowdSimilarity: 0.8, crowdMaxShare: 0.1, bookMaxShare: 1, crowdTenure: 3, crowdTenureCut: 0.5 };
+
+test("crowding: a crowd that has held together for crowdTenure ticks is held to the tighter limit; a one-day overlap is not", () => {
+  const a = { COFFEE: 1 };
+  const b = { COFFEE: 0.9, TEA: -0.1 };
+  // 2 × (1M + 0.9M) = 3.8M = 7.6% of a 50M NAV: inside the 10% clone limit,
+  // over an established crowd's 5%.
+  const scan = (recentA: Record<string, number>[], recentB: Record<string, number>[]) =>
+    scanCrowding(
+      [
+        { name: "a.pod1", capital: 1_000_000, weights: a, recent: recentA },
+        { name: "b.pod2", capital: 1_000_000, weights: b, recent: recentB },
+        { name: "c.pod3", capital: 1_000_000, weights: { GOLD: 1 }, recent: [{ GOLD: 1 }, { GOLD: 1 }] },
+      ],
+      50_000_000,
+      2,
+      tenurePolicy,
+    );
+
+  const held = scan([a, a], [b, b]);
+  assert.deepEqual(held.clusters, [["a.pod1", "b.pod2"]]);
+  assert.deepEqual(held.crowds, [["a.pod1", "b.pod2"]]);
+  assert.equal(held.breaches.length, 1);
+  const cut = held.breaches[0]!;
+  assert.equal(cut.kind, "CROWD");
+  assert.equal(cut.instrument, "COFFEE");
+  assert.equal(cut.limit, 0.05);
+  assert.ok(Math.abs(3_800_000 * cut.scale - 2_500_000) < 1, "cut back exactly to 5% of NAV");
+  assert.deepEqual(cut.contributors, ["a.pod1", "b.pod2"]);
+
+  // The same books today, but a held GOLD two ticks ago: a coincidence, not a crowd.
+  const met = scan([{ GOLD: 1 }, a], [b, b]);
+  assert.deepEqual(met.clusters, [["a.pod1", "b.pod2"]]);
+  assert.deepEqual(met.crowds, []);
+  assert.deepEqual(met.breaches, [], "7.6% is inside the clone limit");
+  // Too little history to call it established.
+  assert.deepEqual(scan([a], [b]).crowds, []);
+  assert.deepEqual(scan([], []).crowds, []);
+  // Off unless both knobs are set: the old checks alone.
+  const off = scanCrowding(
+    [
+      { name: "a.pod1", capital: 1_000_000, weights: a, recent: [a, a] },
+      { name: "b.pod2", capital: 1_000_000, weights: b, recent: [b, b] },
+    ],
+    50_000_000,
+    2,
+    { ...tenurePolicy, crowdTenureCut: 1 },
+  );
+  assert.deepEqual(off.crowds, []);
+  assert.deepEqual(off.breaches, []);
+});
+
+test("crowding: an unfunded agent still makes a trade crowded, but only funded members are cut", () => {
+  const book = { COFFEE: 1 };
+  const scan = scanCrowding(
+    [
+      { name: "funded", capital: 1_000_000, weights: book, recent: [book, book] },
+      { name: "unfunded", capital: 0, weights: { COFFEE: 0.8, TEA: 0.1 }, recent: [book, book] },
+      { name: "gone", capital: 0, weights: {}, recent: [book, book] },
+    ],
+    30_000_000,
+    2,
+    tenurePolicy,
+  );
+  assert.deepEqual(scan.clusters, [], "one funded book is no clone cluster");
+  assert.deepEqual(scan.crowds, [["funded", "unfunded"]], "an agent proposing no book (e.g. revoked) is in no crowd");
+  const cut = scan.breaches.find((b) => b.kind === "CROWD")!;
+  assert.deepEqual(cut.contributors, ["funded"]);
+  // 2M = 6.7% of NAV → back to 5% = 1.5M.
+  assert.ok(Math.abs(2_000_000 * cut.scale - 1_500_000) < 1);
+});
+
+test("crowding: the established-crowd check only ever adds a cut (random books, capital and histories)", () => {
+  const names = ["A", "B", "C", "D", "E"];
+  const templates = [{ A: 1 }, { A: 0.9, B: -0.1 }, { B: 0.5, C: -0.5 }, { C: 1 }, { A: 0.3, B: 0.3, C: 0.2, D: -0.2 }];
+  let crowdCuts = 0;
+  for (let seed = 1; seed <= 400; seed++) {
+    const u = mulberry32(seed);
+    const pick = () => {
+      const t = templates[Math.floor(u() * templates.length)]!;
+      const w: Record<string, number> = {};
+      for (const [k, v] of Object.entries(t)) w[k] = v * (0.8 + 0.4 * u());
+      if (u() < 0.2) w[names[Math.floor(u() * names.length)]!] = u() - 0.5;
+      return w;
+    };
+    const n = 2 + Math.floor(u() * 6);
+    const agents = Array.from({ length: n }, (_, i) => {
+      const weights = u() < 0.1 ? {} : pick();
+      const sticky = u() < 0.6; // a sticky agent held today's book for its whole history
+      const recent = Array.from({ length: Math.floor(u() * 4) }, () => (sticky ? weights : pick()));
+      return { name: `ag${i}`, capital: u() < 0.25 ? 0 : 1e6 * (0.2 + 3 * u()), weights, recent };
+    });
+    const nav = 1e7 * (0.5 + u());
+    const policy = { ...tenurePolicy, crowdMaxShare: 0.05 + 0.1 * u(), bookMaxShare: 0.1 + 0.3 * u() };
+    const withTenure = scanCrowding(agents, nav, 2, policy);
+    const without = scanCrowding(agents, nav, 2, { ...policy, crowdTenure: undefined, crowdTenureCut: undefined });
+
+    // The CLONES and BOOK checks are exactly what they were.
+    assert.deepEqual(withTenure.clusters, without.clusters);
+    assert.deepEqual(withTenure.breaches.filter((b) => b.kind !== "CROWD"), without.breaches, `seed ${seed}`);
+    assert.ok(without.breaches.every((b) => b.kind !== "CROWD"));
+    // No agent keeps more capital; unfunded agents are never cut.
+    const kept = (scan: typeof without, name: string) =>
+      scan.breaches.reduce((m, b) => (b.contributors.includes(name) ? m * b.scale : m), 1);
+    for (const a of agents) {
+      assert.ok(kept(withTenure, a.name) <= kept(without, a.name) + 1e-12, `seed ${seed}: ${a.name} kept more`);
+      if (a.capital === 0) assert.ok(withTenure.breaches.every((b) => !b.contributors.includes(a.name)));
+    }
+    // Every CROWD cut is on an established crowd, and brings its exposure (on
+    // the capital every cut before it left) back exactly to its limit.
+    for (const [i, b] of withTenure.breaches.entries()) {
+      if (b.kind !== "CROWD") continue;
+      crowdCuts++;
+      assert.ok(withTenure.crowds.some((c) => c.join() === b.members.join()));
+      assert.ok(Math.abs(b.limit - policy.crowdTenureCut * policy.crowdMaxShare) < 1e-12);
+      let exposure = 0;
+      for (const m of b.members) {
+        const a = agents.find((x) => x.name === m)!;
+        const before = withTenure.breaches.slice(0, i + 1).reduce((s, x) => (x.contributors.includes(m) ? s * x.scale : s), 1);
+        exposure += a.capital * before * 2 * (a.weights[b.instrument] ?? 0);
+      }
+      if (b.scale > 0) assert.ok(Math.abs(Math.abs(exposure) - b.limit * nav) < 1e-6 * nav, `seed ${seed}: crowd not at its limit`);
+    }
+    // Crowds are exactly the groups linked by pairs whose books pointed the same
+    // way today and at each of the last `crowdTenure − 1` ticks (checked here
+    // independently of the implementation).
+    const heldTogether = (x: (typeof agents)[number], y: (typeof agents)[number]) => {
+      const bx = [...x.recent, x.weights];
+      const by = [...y.recent, y.weights];
+      if (bx.length < policy.crowdTenure || by.length < policy.crowdTenure) return false;
+      if (Object.keys(x.weights).length === 0 || Object.keys(y.weights).length === 0) return false;
+      for (let k = 1; k <= policy.crowdTenure; k++) {
+        if (cosineSimilarity(bx[bx.length - k]!, by[by.length - k]!) < policy.crowdSimilarity) return false;
+      }
+      return true;
+    };
+    const crowdOf = (name: string) => withTenure.crowds.findIndex((c) => c.includes(name));
+    for (const x of agents) {
+      for (const y of agents) {
+        if (x !== y && heldTogether(x, y)) assert.ok(crowdOf(x.name) >= 0 && crowdOf(x.name) === crowdOf(y.name), `seed ${seed}`);
+      }
+      const c = crowdOf(x.name);
+      if (c >= 0) {
+        assert.ok(
+          withTenure.crowds[c]!.some((n) => n !== x.name && heldTogether(x, agents.find((a) => a.name === n)!)),
+          `seed ${seed}: ${x.name} is in a crowd it has not held together with anyone`,
+        );
+      }
+    }
+  }
+  assert.ok(crowdCuts > 20, `the property was exercised (${crowdCuts} crowd cuts)`);
+});
+
