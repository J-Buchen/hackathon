+test("an established crowd is cut to the tighter limit before the unwind, never before it has held together", async () => {
+  const policy = defaultCenterBookPolicy();
+  const on = await runBook(market, genericSwarm(), policy);
+  const off = await runBook(market, genericSwarm(), { ...policy, crowdTenureCut: 1 });
+  const { startTick, crashTick } = market.config.crowd;
+  const established = (b: typeof on) =>
+    b.decisions.filter((d) => d.kind === "CROWDING_CUT" && d.detail.includes("(established crowd)"));
+  assert.equal(established(off).length, 0, "switched off, the check never fires");
+  const first = established(on).find((d) => d.detail.includes("one trade in MEME") && d.t >= startTick);
+  assert.ok(first, "the herd holding MEME together is an established crowd");
+  // The herders' fallback books differ, so they only point the same way from
+  // the day the viral signal appears: no earlier than crowdTenure days in.
+  assert.ok(first!.t >= startTick + policy.crowdTenure - 1, `established on day ${first!.t}, before it had held together`);
+  assert.ok(first!.t < crashTick, "…and cut before the unwind");
+  assert.match(first!.detail, /> 5% limit/);
+  const s = { on: summarize(on, market), off: summarize(off, market) };
+  assert.ok(s.on.crashWindowReturn > s.off.crashWindowReturn, `unwind: ${s.on.crashWindowReturn} vs ${s.off.crashWindowReturn}`);
