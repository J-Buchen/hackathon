index 0000000..4eb6137
--- /dev/null
+++ b/packages/lab/src/arena-ladder-cap.test.ts
@@ -0,0 +1,113 @@
+/**
+ * (G) An operator cap never weakens a name's own ladder, on randomized arena
+ * rosters: every world on research seeds 1–200 where one operator runs two
+ * names, run with operator labels and blind (labels stripped), checked tick
+ * by tick:
+ *
+ *  - every ladder cut of a capped name leaves it at exactly
+ *    min(its budget, cutFactor × min(full size, its uncapped budget)): never
+ *    above cutFactor × what it would hold without the cap (its ladder is not
+ *    weakened), never below cutFactor × min(full size, that) (the cap and the
+ *    cut never compound);
+ *  - a name that is not capped has no separate uncapped budget: it is its own;
+ *  - the tick after each world's first credit event, every capped name's
+ *    uncapped budget is exactly what the blind book gives it (the two books
+ *    are one book until the event, so this pins how the uncapped budget is
+ *    set at the cap, reallocated, and cut by the crowding check);
+ *  - across all those cuts, the capped names hold on average what the blind
+ *    book leaves them after the same cut, where loop 3's rule (cut only down
+ *    to the cap's ceiling) left them more.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { cutToCeiling, defaultCenterBookPolicy, runBook, type BookResult } from "@allowance/swarm";
+import { makeWorld } from "./arena";
+
+// Research seeds only (< ARENA_EVAL_FLOOR).
+const SEEDS = Array.from({ length: 200 }, (_, i) => i + 1);
+const policy = defaultCenterBookPolicy();
+const CF = policy.cutFactor!;
+
+interface Watched {
+  book: BookResult;
+  /** Agent budgets (USDC) at the start of each tick, and after the last one. */
+  budgets: Map<string, number>[];
+}
+
+async function watched(world: ReturnType<typeof makeWorld>, labelled: boolean): Promise<Watched> {
+  const spec = world.swarm();
+  if (!labelled) for (const a of spec.agents) delete a.operator;
+  const names = spec.agents.map((a) => `${a.label}.${a.pod}.${spec.fund}`);
+  const budgets: Map<string, number>[] = [];
+  const read = (tree: BookResult["tree"]) => new Map(names.map((n) => [n, Number(tree.requireNode(n).mandate.budget) / 1e6]));
+  const book = await runBook(world.market, spec, policy, { onTick: (t, tree) => void (budgets[t] = read(tree)) });
+  budgets.push(read(book.tree));
+  return { book, budgets };
+}
+
+const close = (a: number, b: number) => Math.abs(a - b) <= 1e-6 * Math.max(1, Math.abs(b));
+
+test("arena: a capped name's own ladder cuts what it would hold without the cap, never less, never compounded", async () => {
+  const seen = { worlds: 0, cappedTicks: 0, cappedCuts: 0, fixed: 0, firstEventChecks: 0, againstBlind: [] as number[], loop3: [] as number[] };
+  for (const seed of SEEDS) {
+    const world = makeWorld(seed);
+    if (world.meta.sharedOperators === 0) continue;
+    seen.worlds++;
+    const lab = await watched(world, true);
+    const blind = await watched(world, false);
+    const T = lab.book.nav.length;
+    const at = (kind: string, name: string) => lab.book.decisions.filter((d) => d.kind === kind && d.node === name).map((d) => d.t);
+
+    for (const a of lab.book.agents) {
+      // Capped at tick t (when it trades and its ladder moves): after an
+      // operator cut at c < t, up to and including the tick its cap lifts or
+      // its own ladder stops it.
+      const caps = at("OPERATOR_CUT", a.name);
+      const ends = [...at("OPERATOR_RESTORE", a.name), ...at("STOP_OUT", a.name)];
+      const capped = (t: number) => caps.some((c) => c < t && !ends.some((e) => e > c && e < t));
+      const cuts = new Set(at("CUT", a.name));
+      for (let t = 0; t < T; t++) {
+        if (!capped(t)) {
+          assert.equal(a.uncapped[t], a.capital[t], `seed ${seed} ${a.label} t=${t}: not capped, yet an uncapped budget of its own`);
+          continue;
+        }
+        seen.cappedTicks++;
+        if (!cuts.has(t)) continue;
+        // Its own ladder cut, while capped.
+        seen.cappedCuts++;
+        const held = a.capital[t]!;
+        const own = a.uncapped[t]!;
+        const full = a.fullSize[t]!;
+        const after = lab.budgets[t + 1]!.get(a.name)!;
+        assert.ok(close(after, Math.min(held, CF * Math.min(full, own))), `seed ${seed} ${a.label} t=${t}: ${after} vs min(${held}, ${CF} × min(${full}, ${own}))`);
+        assert.ok(after <= CF * own * (1 + 1e-9) + 1e-6, `seed ${seed} ${a.label} t=${t}: its ladder weakened by the cap`);
+        const loop3 = cutToCeiling(held, full, CF) ?? held;
+        if (loop3 > CF * own * (1 + 1e-6)) seen.fixed++;
+        const without = blind.budgets[t + 1]!.get(a.name)!;
+        if (after > 0 && without > 0) {
+          seen.againstBlind.push(Math.log(after / without));
+          seen.loop3.push(Math.log(loop3 / without));
+        }
+      }
+    }
+
+    // The tick after the first credit event: the uncapped budget is the blind book's.
+    const first = lab.book.decisions.find((d) => d.kind === "OPERATOR_CUT");
+    if (first && first.t + 1 < T) {
+      const t = first.t + 1;
+      for (const d of lab.book.decisions.filter((x) => x.kind === "OPERATOR_CUT" && x.t === first.t)) {
+        const a = lab.book.agents.find((x) => x.name === d.node)!;
+        seen.firstEventChecks++;
+        const without = blind.book.agents.find((x) => x.name === a.name)!.capital[t]!;
+        assert.ok(close(a.uncapped[t]!, without), `seed ${seed} ${a.label} t=${t}: uncapped ${a.uncapped[t]} vs blind ${without}`);
+      }
+    }
+  }
+  const mean = (xs: number[]) => xs.reduce((s, x) => s + x, 0) / xs.length;
+  assert.ok(seen.worlds >= 100 && seen.cappedCuts >= 10 && seen.firstEventChecks >= 50, JSON.stringify({ ...seen, againstBlind: undefined, loop3: undefined }));
+  assert.ok(seen.fixed >= 3, `capped cuts loop 3 left above cutFactor × the uncapped budget: ${seen.fixed}`);
+  // Against the blind book (a different book after the event, so not exact):
+  // on average the capped names now hold what the blind book leaves them.
+  assert.ok(Math.abs(mean(seen.againstBlind)) < 0.03, `mean log(capped / blind) after the cut: ${mean(seen.againstBlind)}`);
+  assert.ok(mean(seen.loop3) > 0.1, `loop 3's rule left them more: ${mean(seen.loop3)}`);
+});
