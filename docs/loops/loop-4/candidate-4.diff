 import {
@@ -635,3 +637,27 @@ export function cutToCeiling(capital: number, fullSize: number, factor: number):
   const ceiling = Math.max(0, factor * fullSize);
   return capital > ceiling * (1 + CEILING_SLACK) ? ceiling : null;
 }
+
+/**
+ * Where a name's OWN ladder cut leaves it while its operator's cap holds it.
+ * The ladder cuts every name to `factor` of the capital it holds; a capped
+ * name holds less than it would without the cap, so its ladder cuts what it
+ * WOULD hold (`uncapped`, which the book keeps for every capped name: see
+ * `AgentResult.uncapped`), and the cap's own ceiling, `factor × fullSize`,
+ * still holds on top. Two ceilings, so the smaller one:
+ *
+ *     min(capital, factor × min(fullSize, uncapped))     (`cutToCeiling`)
+ *
+ *  - never above `factor × uncapped`: an operator label never leaves a name
+ *    more capital than its own ladder alone would. (Cutting to the cap's
+ *    ceiling instead left a name that already sat at or below it untouched,
+ *    e.g. after a crowding cut, holding up to twice what its ladder allowed.)
+ *  - never below `factor × min(fullSize, uncapped)`: the cap and the cut do
+ *    not compound. A name at full size that the cap already holds at
+ *    `factor × fullSize` is not cut again, never to factor² × fullSize.
+ *
+ * `null` = no write: it already holds that or less (a cut never grows a name).
+ */
+export function ladderCutUnderCap(capital: number, fullSize: number, factor: number, uncapped: number): number | null {
+  return cutToCeiling(capital, Math.min(fullSize, uncapped), factor);
+}
