+test("ladderCutUnderCap: a capped name's own ladder cuts what it would hold uncapped — never lighter than its ladder alone, never cutFactor²", () => {
+  const full = 1_000_000;
+  // At full size, capped to the ceiling: its ladder's cut lands on the same ceiling, so no write.
+  assert.equal(ladderCutUnderCap(500_000, full, 0.5, full), null);
+  assert.equal(ladderCutUnderCap(500_000 * (1 + CEILING_SLACK / 2), full, 0.5, full), null, "a rounding unit above is at it");
+  // At the ceiling on its OWN account (its ladder cut it and restored it): its ladder cuts it again.
+  assert.equal(ladderCutUnderCap(500_000, full, 0.5, 500_000), 250_000);
+  // Below the ceiling after a crowding cut: cut from there. Loop 3's rule cut to the ceiling: no cut at all.
+  assert.equal(ladderCutUnderCap(312_500, full, 0.5, 312_500), 156_250);
+  assert.equal(cutToCeiling(312_500, full, 0.5), null);
+  // Crowding-cut to 625k, then capped to the 500k ceiling: cutFactor × the 625k it would hold uncapped.
+  assert.equal(ladderCutUnderCap(500_000, full, 0.5, 625_000), 312_500);
+  assert.equal(cutToCeiling(500_000, full, 0.5), null);
+  // Above its full size (the rebalance band): the cap's ceiling still holds on top.
+  assert.equal(ladderCutUnderCap(550_000, full, 0.5, 1_100_000), 500_000);
+  // A cut never grows a name.
+  assert.equal(ladderCutUnderCap(100_000, full, 0.5, 625_000), null);
+  assert.equal(ladderCutUnderCap(0, 0, 0.5, 0), null);
+
+  for (const factor of [0.25, 0.5, 0.75]) {
+    for (const capital of [0, 50_000, 250_000, 400_000, 500_000, 700_000, 1_000_000, 1_200_000]) {
+      for (const uncapped of [capital, 1.25 * capital, 2 * capital, 300_000, 800_000, full, 1.3 * full]) {
+        const to = ladderCutUnderCap(capital, full, factor, uncapped);
+        const after = to ?? capital;
+        const cut = factor * Math.min(full, uncapped);
+        const at = `factor ${factor}, capital ${capital}, uncapped ${uncapped}`;
+        // Never lighter than its own ladder on what it would hold uncapped, never grown.
+        assert.ok(after <= factor * uncapped * (1 + CEILING_SLACK), `${at}: weaker than its ladder`);
+        assert.ok(after <= capital, `${at}: grown`);
+        // Never compounded: a write lands exactly on cutFactor × min(full size, uncapped).
+        if (to !== null) assert.equal(to, cut, at);
+        assert.ok(after >= Math.min(capital, cut), `${at}: cut below the one ceiling`);
+        // With nothing held back by the cap (uncapped = capital ≤ full size), exactly the plain ladder's cut.
+        if (uncapped === capital && capital <= full) assert.equal(after, factor * capital, at);
+      }
+    }
+  }
+});
+
