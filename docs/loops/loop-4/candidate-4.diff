+/**
+ * (G) An operator cap never weakens a name's OWN ladder. When one of an
+ * operator's names is stopped out, its other names are capped at cutFactor of
+ * their full size; when a capped name's own ladder then cuts it, the ladder
+ * cuts what the name would hold WITHOUT the cap (`AgentResult.uncapped`), and
+ * the cap's ceiling holds on top (`ladderCutUnderCap`).
+ *
+ * Checked on scripted markets (each agent's record is written tick by tick),
+ * each run twice: with operator labels and blind (labels stripped). Each book
+ * is built so the two runs trade the same budgets except where the cap bites,
+ * so "as hard as without labels" is checked exactly, name by name.
+ *
+ * Book A, five ways to sit under the cap when the credit event comes:
+ *  - bounce: its ladder cut and restored it, so it sits AT the cap's ceiling
+ *    when capped, on its own account; its ladder then cuts it again;
+ *  - deep:   the crowding check cut it BELOW the ceiling before the cap; its
+ *    ladder then cuts it;
+ *  - part:   the crowding check cut it to between the ceiling and full size;
+ *    the cap takes it down to the ceiling; its ladder then cuts it;
+ *  - atfull: at full size when capped (the cap takes it to the ceiling); its
+ *    ladder then cuts it: NOT again (the loop-3 guarantee: no cutFactor²);
+ *  - late:   capped at full size, reallocated while capped, then cut by its
+ *    ladder: not again either.
+ * Book B: a crowding cut that only the uncapped book takes. After the cap,
+ * a reallocation sizes `paired` and its crowd-mate so that, uncapped, their
+ * shared instrument breaches the book limit; capped, it does not. Its ladder
+ * then cuts it from the crowding-cut budget, as the book without labels does.
+ *
+ * Loop 3 cut a capped name's ladder to the cap's ceiling instead, so bounce,
+ * deep, part and paired were not cut at all: they held 2×, 2×, 1.28× and
+ * 1.07× what the same book gives them without operator labels. The two "as
+ * hard as" tests fail on that code (as do the two on the uncapped budget: it
+ * had none); the rest pin what must not change (no cutFactor², no stop-out
+ * moved, nothing revoked, the tree sound).
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { defaultCenterBookPolicy, ladderStep, type LadderState } from "./allocator";
+import { runBook, type BookResult } from "./book";
+import { generateMarket } from "./market";
+import type { Strategy, Weights } from "./strategies";
+
+const FUND = "fund.eth";
+const AUM = 10_000_000;
+const policy = defaultCenterBookPolicy();
+const CF = policy.cutFactor!;
+const T = 40;
+
+/** base ± amp, alternating: a low-vol record, so every rung is at its fixed floor. */
+const alt = (t: number, base: number, amp: number) => base + (t % 2 === 0 ? amp : -amp);
+/** A shock of `size` at tick `at`, nothing else. */
+const shock = (at: number, size: number) => (t: number) => (t === at ? size : 0);
+/** Rising to its high at t = 12 (the credit event), then flat: no new high, so the cap stays on. */
+const risingThenFlat = (t: number) => (t <= 12 ? alt(t, 0.003, 0.002) : 0);
+/** The loser: stopped out at t = 12, the credit event. */
+const loser = (t: number) => (t < 12 ? alt(t, 0.003, 0.002) : t === 12 ? -0.25 : 0);
+/** Steady earners: NAV stays above AUM, so both runs of a book deploy the same capital. */
+const steady = (t: number) => alt(t, 0.03, 0.002);
+
+class Hold implements Strategy {
+  readonly style = "hold";
+  constructor(private readonly weights: Weights) {}
+  decide(): Weights {
+    return { ...this.weights };
+  }
+}
+
+type Roster = [label: string, weights: Weights, pod: string, operator?: string][];
+
+interface Run {
+  book: BookResult;
+  /** Agent budgets (USDC) at the start of each tick, and after the last one: [t][label]. */
+  budgets: Map<string, number>[];
+}
+
+/** One scripted book, run with operator labels and blind. */
+function scriptedBook(seed: number, scripts: Record<string, (t: number) => number>, roster: Roster) {
+  const instruments = Object.keys(scripts);
+  const market = generateMarket({
+    seed,
+    ticks: T,
+    instruments,
+    factorVol: 0.008,
+    idioVol: 0.01,
+    // No crowd in these markets.
+    crowd: { instrument: instruments[0]!, startTick: 10_000, crashTick: 10_001, inflowDrift: 0, crashSize: 0, contagion: 0 },
+  });
+  for (const tick of market.ticks) for (const s of instruments) tick.returns[s] = scripts[s]!(tick.t);
+  const nameOf = (label: string) => `${label}.${roster.find(([l]) => l === label)![2]}.${FUND}`;
+  const run = async (labelled: boolean): Promise<Run> => {
+    const budgets: Map<string, number>[] = [];
+    const read = (tree: BookResult["tree"]) =>
+      new Map(roster.map(([l]) => [l, Number(tree.requireNode(nameOf(l)).mandate.budget) / 1e6]));
+    const spec = {
+      principal: "alice",
+      fund: FUND,
+      aum: AUM,
+      pods: ["alpha", "beta"].map((label) => ({ label, instruments })),
+      agents: roster.map(([label, weights, pod, operator]) => ({
+        label,
+        pod,
+        ...(labelled && operator ? { operator } : {}),
+        instruments,
+        strategy: new Hold(weights),
+      })),
+    };
+    const book = await runBook(market, spec, policy, { onTick: (t, tree) => void (budgets[t] = read(tree)) });
+    budgets.push(read(book.tree));
+    return { book, budgets };
+  };
+  return { lab: run(true), blind: run(false), nameOf, perAgent: (AUM * policy.deploy) / roster.length };
+}
+
+const agent = (r: Run, label: string) => r.book.agents.find((a) => a.label === label)!;
+/** Budget at the end of tick t (= the start of t + 1). */
+const endOf = (r: Run, t: number, label: string) => r.budgets[t + 1]!.get(label)!;
+const near = (a: number, b: number, what: string) => assert.ok(Math.abs(a - b) <= 1e-6 * Math.max(1, Math.abs(b)), `${what}: ${a} vs ${b}`);
+const decisionsAt = (r: Run, t: number, kind: string) => r.book.decisions.filter((d) => d.t === t && d.kind === kind).map((d) => d.node);
+
+/** An agent's final ladder state from ITS OWN record alone: no book, no capital, no siblings. */
+function ownLadder(unitReturns: readonly number[]): LadderState {
+  return unitReturns.reduce<LadderState>(
+    (state, _, t) =>
+      ladderStep(state, unitReturns.slice(0, t + 1), {
+        ddStop: policy.ddStop,
+        ddCut: policy.ddCut,
+        ddRecover: policy.ddRecover,
+        ddStopVol: policy.ddStopVol,
+        volWindow: policy.window,
+        ddStopMax: policy.ddStopMax,
+      }).next,
+    "active",
+  );
+}
+
+/**
+ * Each capped name after its own ladder cut, against the same book without
+ * labels: it must hold what its ladder leaves it there, under the cap's
+ * ceiling. Returns the names that hold anything else.
+ */
+function asHardAsBlind(lab: Run, blind: Run, cuts: readonly [string, number][], nameOf: (l: string) => string): string[] {
+  const off: string[] = [];
+  for (const [l, t] of cuts) {
+    // The same record, the same ladder move, in both runs.
+    assert.ok(decisionsAt(blind, t, "CUT").includes(nameOf(l)), `${l}: its blind ladder cuts at t=${t}`);
+    const want = Math.min(endOf(blind, t, l), CF * agent(lab, l).fullSize[t]!);
+    const got = endOf(lab, t, l);
+    if (Math.abs(got - want) > 1e-6 * want) off.push(`${l} at t=${t}: holds ${got.toFixed(0)}, without labels ${endOf(blind, t, l).toFixed(0)}`);
+  }
+  return off;
+}
+
+/* ------------------------------------------------------------------ */
+/* Book A: five ways to sit under the cap                             */
+/* ------------------------------------------------------------------ */
+
+const A = scriptedBook(
+  23,
+  {
+    L: loser,
+    // At full size when capped; its own ladder cuts it at t = 16.
+    A: (t) => (t === 16 ? -0.11 : risingThenFlat(t)),
+    // Cut at t = 4, restored at t = 5 (still at cutFactor × its size at t = 12), cut again at t = 16.
+    B: (t) => (t <= 3 ? alt(t, 0.01, 0.002) : t === 4 ? -0.12 : t === 5 ? 0.08 : t < 16 ? 0.001 : t === 16 ? -0.12 : 0),
+    // Two crowded pairs: `deep` and `part` share C1 / C2 with a twin run by another operator.
+    C1: risingThenFlat,
+    C2: risingThenFlat,
+    D1: shock(18, -0.6), // deep's own leg: its ladder cuts it at t = 18
+    D2: shock(20, -0.6), // part's own leg: its ladder cuts it at t = 20
+    E1: () => 0,
+    E2: () => 0,
+    // Capped at full size, reallocated at t = 30 while capped, cut by its ladder at t = 33.
+    G: (t) => (t === 33 ? -0.11 : risingThenFlat(t)),
+    Y1: steady,
+    Y2: steady,
+  },
+  [
+    ["loser", { L: 0.5 }, "alpha", "mallory"],
+    ["atfull", { A: 0.5 }, "alpha", "mallory"],
+    ["bounce", { B: 0.5 }, "beta", "mallory"],
+    // At 10 names × 800k: 2 × 1.28M on C1 is 25.6% of NAV → both scaled ×0.39 (below the cap's ×0.5).
+    ["deep", { C1: 0.8, D1: 0.1 }, "alpha", "mallory"],
+    ["deeptwin", { C1: 0.8, E1: 0.1 }, "beta", "op-x"],
+    // 2 × 640k on C2 is 12.8% of NAV → both scaled ×0.78 (between the cap and full size).
+    ["part", { C2: 0.4, D2: 0.1 }, "beta", "mallory"],
+    ["parttwin", { C2: 0.4, E2: 0.1 }, "alpha", "op-y"],
+    ["late", { G: 0.5 }, "beta", "mallory"],
+    ["steady1", { Y1: 0.25 }, "alpha", "op-b"],
+    ["steady2", { Y2: 0.25 }, "beta"],
+  ],
+);
+
+/** Every capped name's own ladder cut in book A: [label, tick]. */
+const A_CUTS: [string, number][] = [
+  ["atfull", 16],
+  ["bounce", 16],
+  ["deep", 18],
+  ["part", 20],
+  ["late", 33],
+];
+
+test("book A plays out: the crowding cuts, the credit event and each capped name's own ladder cut land where written", async () => {
+  const lab = await A.lab;
+  const blind = await A.blind;
+  const { nameOf, perAgent } = A;
+  assert.deepEqual(
+    lab.book.decisions.filter((d) => d.kind === "CROWDING_CUT").map((d) => [d.t, d.node]),
+    [
+      [0, [nameOf("deep"), nameOf("deeptwin")].join(", ")],
+      [0, [nameOf("part"), nameOf("parttwin")].join(", ")],
+    ],
+  );
+  assert.deepEqual(decisionsAt(lab, 12, "STOP_OUT"), [nameOf("loser")]);
+  assert.deepEqual(decisionsAt(lab, 12, "OPERATOR_CUT"), ["atfull", "bounce", "deep", "part", "late"].map(nameOf));
+  assert.deepEqual(
+    lab.book.decisions.filter((d) => d.kind === "CUT").map((d) => [d.node, d.t]),
+    [["bounce", 4] as [string, number], ...A_CUTS].map(([l, t]) => [nameOf(l), t]),
+  );
+  assert.deepEqual(lab.book.decisions.filter((d) => d.kind === "OPERATOR_RESTORE"), [], "every cap holds to the end");
+  // Where each capped name stands when capped (end of t = 11), against the cap's ceiling.
+  near(endOf(lab, 11, "atfull"), perAgent, "atfull at full size");
+  near(endOf(lab, 11, "bounce"), CF * perAgent, "bounce at the ceiling, on its own ladder's account");
+  assert.ok(endOf(lab, 11, "deep") < 0.8 * CF * perAgent, "deep well below the ceiling (crowding)");
+  assert.ok(endOf(lab, 11, "part") > 1.5 * CF * perAgent && endOf(lab, 11, "part") < perAgent, "part between the ceiling and full size");
+  // The cap cut only the names above its ceiling.
+  for (const l of ["atfull", "part", "late"]) near(endOf(lab, 12, l), CF * perAgent, `${l} capped to the ceiling`);
+  for (const l of ["bounce", "deep"]) assert.equal(endOf(lab, 12, l), endOf(lab, 11, l), `${l} already at or below the ceiling`);
+  // Both runs deploy the same capital at the reallocation that sizes `late` while capped.
+  for (const r of [lab, blind]) assert.ok(r.book.nav.every((n) => n > AUM), "NAV above AUM throughout");
+  assert.ok(decisionsAt(lab, 30, "REALLOCATE").includes(nameOf("late")), "late is resized while capped");
+});
+
+test("book A: a capped name's own ladder cut is exactly as hard as the same book cuts it without operator labels", async () => {
+  const lab = await A.lab;
+  const blind = await A.blind;
+  const { perAgent } = A;
+  assert.deepEqual(asHardAsBlind(lab, blind, A_CUTS, A.nameOf), [], "capped names left more than their own ladder leaves them");
+  // Where the cap already held a name at full size down at the ceiling, its
+  // ladder's cut lands on the same ceiling: that is no cut, not cutFactor².
+  // Everywhere else its ladder cuts it, the cap or no cap.
+  near(endOf(lab, 16, "bounce"), CF * CF * perAgent, "bounce: cut again by its own ladder, as blind");
+  near(endOf(lab, 18, "deep"), CF * endOf(lab, 17, "deep"), "deep: cut from below the ceiling, as blind");
+  near(endOf(lab, 20, "part"), CF * endOf(blind, 19, "part"), "part: cutFactor × what it would hold uncapped");
+  assert.ok(endOf(lab, 20, "part") < endOf(lab, 19, "part"), "part cut below the cap's ceiling");
+});
+
+test("book A: the cap and the ladder never compound — a name the cap already holds at the ceiling is not cut again", async () => {
+  const lab = await A.lab;
+  const blind = await A.blind;
+  for (const l of ["atfull", "late"]) {
+    const t = A_CUTS.find(([x]) => x === l)![1];
+    assert.equal(endOf(lab, t, l), endOf(lab, t - 1, l), `${l} halved again by its own ladder`);
+    assert.match(lab.book.decisions.find((d) => d.t === t && d.kind === "CUT" && d.node === A.nameOf(l))!.detail, /not cut again/);
+    near(endOf(lab, t, l), CF * agent(lab, l).fullSize[t]!, `${l} at cutFactor × full size`);
+    near(endOf(lab, t, l), endOf(blind, t, l), `${l}: as blind (full size, then cut)`);
+  }
+  // No capped name's cut ever lands below cutFactor × min(full size, what it holds blind).
+  for (const [l, t] of A_CUTS) {
+    const floor = CF * Math.min(agent(lab, l).fullSize[t]!, agent(blind, l).capital[t]!);
+    assert.ok(endOf(lab, t, l) >= floor * (1 - 1e-9), `${l} at t=${t}: ${endOf(lab, t, l)} below ${floor}`);
+  }
+});
+
+test("book A: the uncapped budget is exactly the budget the same book gives each name without operator labels", async () => {
+  const lab = await A.lab;
+  const blind = await A.blind;
+  for (const a of lab.book.agents) {
+    const b = agent(blind, a.label);
+    assert.equal(a.uncapped.length, T);
+    for (let t = 0; t < T; t++) near(a.uncapped[t]!, b.capital[t]!, `${a.label} at t=${t}`);
+  }
+  // …and differs from the capped budget exactly while the cap bites.
+  const late = agent(lab, "late");
+  assert.ok(late.uncapped[20]! > late.capital[20]! * 1.9, "late: the cap holds it at half its uncapped budget");
+  near(late.capital[31]!, CF * late.uncapped[31]!, "late after the reallocation: capped at cutFactor of its uncapped (= full) size");
+});
+
+test("book A: no ladder move is delayed or advanced, and nothing but a stop-out revokes a mandate", async () => {
+  const lab = await A.lab;
+  const blind = await A.blind;
+  const moves = (b: BookResult) =>
+    b.decisions.filter((d) => d.kind === "STOP_OUT" || d.kind === "CUT" || d.kind === "RESTORE").map((d) => `${d.t} ${d.kind} ${d.node}`);
+  assert.deepEqual(moves(lab.book), moves(blind.book));
+  for (const a of lab.book.agents) {
+    assert.equal(a.ladder, ownLadder(a.unitReturns), `${a.label}: its own ladder`);
+    assert.equal(lab.book.tree.isRevokedInChain(a.name), a.ladder === "stopped", `${a.label}: revoked iff stopped`);
+  }
+  assert.deepEqual(lab.book.tree.audit(), []);
+  assert.ok(!lab.book.tree.events.some((e) => e.result === "ATTENUATION_REJECTED"));
+});
+
+/* ------------------------------------------------------------------ */
+/* Book B: a crowding cut only the uncapped book takes                */
+/* ------------------------------------------------------------------ */
+
+const B = scriptedBook(
+  29,
+  {
+    L: loser,
+    C3: risingThenFlat,
+    D3: shock(34, -0.2), // paired's own leg: its ladder cuts it at t = 34
+    E3: () => 0,
+    Y1: steady,
+    Y2: steady,
+  },
+  [
+    ["loser", { L: 0.5 }, "alpha", "mallory"],
+    // Not clones (cosine 0.5), but the book's net C3 exposure is capped at 20% of
+    // NAV: at 1.6M each it is 19.2% of NAV; at the 2M each the reallocation at
+    // t = 30 gives them, 21.5% (breach) uncapped, 16% with paired capped.
+    ["paired", { C3: 0.3, D3: 0.3 }, "alpha", "mallory"],
+    ["pairtwin", { C3: 0.3, E3: 0.3 }, "beta", "op-z"],
+    ["steady1", { Y1: 0.25 }, "alpha", "op-b"],
+    ["steady2", { Y2: 0.25 }, "beta"],
+  ],
+);
+
+test("book B plays out: the uncapped book breaches the crowding limit at the reallocation, the capped one does not", async () => {
+  const lab = await B.lab;
+  const blind = await B.blind;
+  const { nameOf } = B;
+  assert.deepEqual(decisionsAt(lab, 12, "OPERATOR_CUT"), [nameOf("paired")]);
+  assert.deepEqual(lab.book.decisions.filter((d) => d.kind === "CROWDING_CUT"), [], "capped, the book is within its limits");
+  const crowding = blind.book.decisions.filter((d) => d.kind === "CROWDING_CUT");
+  assert.deepEqual(crowding.map((d) => [d.t, d.node]), [[30, [nameOf("paired"), nameOf("pairtwin")].join(", ")]]);
+  assert.deepEqual(decisionsAt(lab, 34, "CUT"), [nameOf("paired")]);
+  assert.deepEqual(lab.book.decisions.filter((d) => d.kind === "OPERATOR_RESTORE"), [], "the cap holds to the end");
+  // The two books trade the same NAV until paired's own cut (a capped name that earns nothing earns nothing either way).
+  assert.deepEqual(lab.book.nav.slice(0, 34), blind.book.nav.slice(0, 34));
+  for (const r of [lab, blind]) assert.ok(r.book.nav.every((n) => n > AUM), "NAV above AUM throughout");
+});
+
+test("book B: the uncapped budget takes the crowding cut the book without labels takes, and the ladder cuts from there", async () => {
+  const lab = await B.lab;
+  const blind = await B.blind;
+  assert.deepEqual(asHardAsBlind(lab, blind, [["paired", 34]], B.nameOf), [], "paired left more than its own ladder leaves it");
+  assert.ok(endOf(lab, 34, "paired") < endOf(lab, 33, "paired"), "cut below the cap's ceiling");
+  const paired = agent(lab, "paired");
+  for (let t = 0; t <= 34; t++) near(paired.uncapped[t]!, agent(blind, "paired").capital[t]!, `paired's uncapped budget at t=${t}`);
+  assert.ok(paired.uncapped[31]! < paired.fullSize[31]! * 0.95, "cut below its full size by the crowding check");
+  near(paired.capital[31]!, CF * paired.fullSize[31]!, "while the book itself is held at the cap's ceiling");
+  // The crowding check on the uncapped book never cuts the book itself: its crowd-mate keeps its size.
+  near(agent(lab, "pairtwin").capital[31]!, agent(lab, "pairtwin").fullSize[31]!, "pairtwin at full size");
+  assert.deepEqual(lab.book.tree.audit(), []);
+});
