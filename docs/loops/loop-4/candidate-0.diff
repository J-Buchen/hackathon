index 0000000..131740a
--- /dev/null
+++ b/packages/swarm/src/credibility.test.ts
@@ -0,0 +1,210 @@
+/**
+ * (A) Capital follows evidence: an agent's share moves from the prior (the
+ * book's equal grant) to its record's verdict only as fast as its record
+ * becomes credible, Z = min(1, √(n / 252)) = min(1, 1 / SE of its Sharpe).
+ *
+ *  - a lucky 30-tick record cannot win a full slot: the maximum share is
+ *    Z × maxAgentShare + (1 − Z) × prior, and grows with the record;
+ *  - a record the allocator would defund keeps only its (1 − Z) prior slice;
+ *  - capital the record's capped leaders cannot take stays in cash;
+ *  - at full credibility (a year of record) the allocation is the record's
+ *    verdict exactly, and `fullCredibilityObs: 0` is the allocator without it;
+ *  - records of different lengths: a newcomer is bounded by its own
+ *    credibility and nobody is ever scaled UP to make room.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  allocate,
+  capShares,
+  credibility,
+  credibleShares,
+  defaultCenterBookPolicy,
+  priorShares,
+  type AgentScore,
+  type AgentScoreInput,
+} from "./allocator";
+import { gaussian, mulberry32 } from "./rng";
+
+const noise = (seed: number, n: number, drift = 0) => {
+  const z = gaussian(mulberry32(seed));
+  return Array.from({ length: n }, () => drift + 0.01 * z());
+};
+const close = (a: number, b: number, eps = 1e-12) => Math.abs(a - b) <= eps;
+const by = (out: AgentScore[]) => new Map(out.map((s) => [s.name, s]));
+const total = (out: AgentScore[]) => out.reduce((s, x) => s + x.share, 0);
+
+/** Eight agents: one with a strong record, seven whose records are negative. */
+function roster(n: number, prefix = 0): AgentScoreInput[] {
+  const agents: AgentScoreInput[] = [{ name: "lucky", unitReturns: noise(100 + prefix, n, 0.01), stopped: false, ladderMultiplier: 1 }];
+  for (let i = 0; i < 7; i++) {
+    agents.push({ name: `loser-${i}`, unitReturns: noise(200 + i + prefix, n, -0.006), stopped: false, ladderMultiplier: 1 });
+  }
+  return agents;
+}
+
+test("credibility: min(1, √(n / 252)), the inverse of a Sharpe ratio's standard error; 0 turns it off", () => {
+  assert.equal(credibility(0, 252), 0);
+  assert.ok(close(credibility(30, 252), Math.sqrt(30 / 252)));
+  assert.ok(close(credibility(63, 252), 0.5));
+  assert.equal(credibility(252, 252), 1);
+  assert.equal(credibility(1000, 252), 1);
+  for (let n = 1; n <= 252; n++) {
+    const se = Math.sqrt(252 / n); // standard error of an annualized Sharpe on n daily returns
+    assert.ok(close(credibility(n, 252), 1 / se), `n = ${n}`);
+    assert.ok(credibility(n, 252) > credibility(n - 1, 252), "grows with every tick of record");
+  }
+  assert.equal(credibility(5, 0), 1);
+  assert.equal(credibility(5, -1), 1);
+  assert.equal(defaultCenterBookPolicy().fullCredibilityObs, 252);
+});
+
+test("priorShares: the book's equal grant, capped like any share (the rest stays in cash)", () => {
+  assert.deepEqual(priorShares(8, 0.25), Array(8).fill(1 / 8));
+  assert.deepEqual(priorShares(3, 0.25), [0.25, 0.25, 0.25]);
+  assert.deepEqual(priorShares(0, 0.25), []);
+});
+
+test("credibleShares: a convex combination of the record's verdict and the prior", () => {
+  const record = capShares([5, 1, 0, 0, 0], 0.25); // [0.25, 0.25, 0, 0, 0]: both capped, half the book in cash
+  assert.deepEqual(record, [0.25, 0.25, 0, 0, 0]);
+  const prior = priorShares(5, 0.25);
+  const at = (z: number) => credibleShares(record, prior, record.map(() => z));
+  assert.deepEqual(at(1), record, "full credibility is the record's verdict, bit for bit");
+  assert.deepEqual(at(0), prior, "no credibility is the prior");
+  for (const z of [0.1, 0.35, 0.5, 0.9]) {
+    const s = at(z);
+    s.forEach((x, i) => {
+      assert.ok(close(x, z * record[i]! + (1 - z) * prior[i]!));
+      assert.ok(x <= 0.25 + 1e-15, "never above the cap");
+    });
+    assert.ok(s.reduce((a, b) => a + b, 0) <= 1 + 1e-12);
+  }
+  // Different credibilities can over-commit (full-credibility leaders plus a
+  // newcomer's prior slice): everyone is scaled down together, never up.
+  const lead = [0.25, 0.25, 0.25, 0.25, 0];
+  const mixed = credibleShares(lead, priorShares(5, 0.25), [1, 1, 1, 1, 0]);
+  assert.ok(close(mixed.reduce((a, b) => a + b, 0), 1));
+  mixed.slice(0, 4).forEach((x) => assert.ok(x < 0.25 && close(x, 0.25 / 1.2)));
+  assert.ok(close(mixed[4]!, 0.2 / 1.2));
+  const under = credibleShares([0.1, 0.1], [0.25, 0.25], [1, 0.5]);
+  assert.deepEqual(under, [0.1, 0.5 * 0.1 + 0.5 * 0.25], "a total under 1 is left as it is (cash), not scaled up");
+});
+
+test("allocate: a lucky 30-tick record cannot win a full slot; its maximum share grows with its record", () => {
+  const policy = defaultCenterBookPolicy();
+  const cap = policy.maxAgentShare;
+  const early = roster(30);
+  const recordOnly = by(allocate(early, 1, { ...policy, fullCredibilityObs: 0 }));
+  // Precondition: the record alone hands the lucky agent the full slot and defunds the rest.
+  assert.equal(recordOnly.get("lucky")!.share, cap);
+  for (let i = 0; i < 7; i++) assert.equal(recordOnly.get(`loser-${i}`)!.share, 0);
+
+  const out = allocate(early, 1, policy);
+  const s = by(out);
+  const z = Math.sqrt(30 / 252);
+  assert.ok(close(s.get("lucky")!.credibility, z));
+  assert.equal(s.get("lucky")!.recordShare, cap, "the record's verdict is kept for the log");
+  assert.ok(close(s.get("lucky")!.share, z * cap + (1 - z) / 8));
+  assert.ok(s.get("lucky")!.share < 0.7 * cap, `30 ticks of record buy ${(s.get("lucky")!.share * 100).toFixed(1)}% of deployable, not ${cap * 100}%`);
+  // Capital the capped leader cannot take is not pushed onto the others: they
+  // hold their prior slice and no more, and the rest of the book stays in cash.
+  for (let i = 0; i < 7; i++) assert.ok(close(s.get(`loser-${i}`)!.share, (1 - z) / 8));
+  assert.ok(close(total(out), z * cap + (1 - z)));
+  assert.ok(total(out) < 1);
+
+  // The same edge with a longer record: the ceiling and the share grow with the evidence.
+  let prev = 0;
+  for (const n of [30, 60, 126, 200, 252]) {
+    const agents = roster(n);
+    const r = by(allocate(agents, 1, { ...policy, fullCredibilityObs: 0 }));
+    assert.equal(r.get("lucky")!.share, cap, `n = ${n}: the record alone gives the full slot`);
+    const zn = Math.min(1, Math.sqrt(n / 252));
+    const lucky = by(allocate(agents, 1, policy)).get("lucky")!;
+    assert.ok(lucky.share <= zn * cap + (1 - zn) / 8 + 1e-15, `n = ${n}: within its credibility`);
+    assert.ok(lucky.share > prev, `n = ${n}: grows with the record`);
+    prev = lucky.share;
+  }
+  assert.equal(prev, cap, "a year of record earns the full slot");
+});
+
+test("allocate: a record the allocator would defund keeps only its (1 − Z) prior slice, gone at full credibility", () => {
+  const policy = defaultCenterBookPolicy();
+  for (const n of [30, 90, 180, 252, 300]) {
+    const s = by(allocate(roster(n), 1, policy));
+    const zn = Math.min(1, Math.sqrt(Math.min(n, policy.recordWindow) / 252));
+    for (let i = 0; i < 7; i++) {
+      assert.equal(s.get(`loser-${i}`)!.recordShare, 0);
+      assert.ok(close(s.get(`loser-${i}`)!.share, (1 - zn) / 8), `n = ${n}`);
+    }
+  }
+  assert.equal(by(allocate(roster(252), 1, policy)).get("loser-0")!.share, 0);
+});
+
+test("allocate: at full credibility the allocation is the record's verdict exactly", () => {
+  const policy = { ...defaultCenterBookPolicy(), maxAgentShare: 0.4 };
+  const agents: AgentScoreInput[] = [0.001, 0.0005, -0.0004, 0.0012, 0].map((drift, i) => ({
+    name: `a${i}`,
+    unitReturns: noise(300 + i, 260, drift),
+    stopped: i === 4,
+    ladderMultiplier: i === 1 ? 0.5 : 1,
+    ...(i === 3 ? { crowdCap: 1000 } : {}),
+  }));
+  const full = allocate(agents, 1_000_000, policy);
+  const off = allocate(agents, 1_000_000, { ...policy, fullCredibilityObs: 0 });
+  assert.deepEqual(
+    full.map((s) => [s.name, s.share, s.fullTarget, s.target]),
+    off.map((s) => [s.name, s.share, s.fullTarget, s.target]),
+  );
+  assert.ok(full.every((s) => s.credibility === 1 || s.name === "a4"));
+});
+
+test("allocate: stopped agents get nothing and take no prior slice", () => {
+  const policy = defaultCenterBookPolicy();
+  const agents = roster(30).map((a, i) => ({ ...a, stopped: i >= 5 }));
+  const out = allocate(agents, 1, policy);
+  const z = Math.sqrt(30 / 252);
+  const s = by(out);
+  for (const a of agents) {
+    if (a.stopped) assert.equal(s.get(a.name)!.share, 0);
+    else if (a.name !== "lucky") assert.ok(close(s.get(a.name)!.share, (1 - z) / 5), "the prior is split among the 5 live agents");
+  }
+});
+
+test("allocate: credibility reads only how long each record is (the same for any record of that length)", () => {
+  const policy = defaultCenterBookPolicy();
+  const a = allocate(roster(45), 1, policy);
+  const b = allocate(roster(45, 17), 1, policy);
+  assert.ok(a.every((s) => close(s.credibility, Math.sqrt(45 / 252))));
+  assert.deepEqual(
+    a.map((s) => s.credibility),
+    b.map((s) => s.credibility),
+  );
+  // Only the returns the score is estimated on count: never more than `recordWindow`.
+  const long = allocate(roster(400), 1, { ...policy, recordWindow: 126 });
+  assert.ok(long.every((s) => close(s.credibility, Math.sqrt(126 / 252))), "a 126-tick score has a 126-tick standard error");
+});
+
+test("allocate: a newcomer among incumbents is bounded by its own credibility, and nobody is scaled up", () => {
+  const policy = defaultCenterBookPolicy();
+  const cap = policy.maxAgentShare;
+  const incumbents: AgentScoreInput[] = [0.001, 0.0008, 0.0012, 0.0009].map((drift, i) => ({
+    name: `inc-${i}`,
+    unitReturns: noise(400 + i, 252, drift),
+    stopped: false,
+    ladderMultiplier: 1,
+  }));
+  const newcomer: AgentScoreInput = { name: "new", unitReturns: noise(500, 10, 0.02), stopped: false, ladderMultiplier: 1 };
+  const agents = [...incumbents, newcomer];
+  const out = allocate(agents, 1, policy);
+  const s = by(out);
+  const zNew = Math.sqrt(10 / 252);
+  assert.ok(close(s.get("new")!.credibility, zNew));
+  assert.ok(s.get("new")!.share <= zNew * cap + (1 - zNew) / 5 + 1e-15);
+  for (const a of incumbents) {
+    assert.equal(s.get(a.name)!.credibility, 1);
+    assert.ok(s.get(a.name)!.share <= s.get(a.name)!.recordShare + 1e-15, `${a.name}: only ever scaled down`);
