diff --git a/packages/lab/src/arena-credibility.test.ts b/packages/lab/src/arena-credibility.test.ts
new file mode 100644
index 0000000..c726411
--- /dev/null
+++ b/packages/lab/src/arena-credibility.test.ts
@@ -0,0 +1,110 @@
+/**
+ * (A) Capital follows evidence, on randomized arena rosters (research seeds
+ * 1–40). Every agent starts together, so at a scheduled reallocation on tick t
+ * every record is t ticks long and has credibility Z = min(1, √(t / 252)).
+ * Checked at every reallocation of every world, from what the book records
+ * (each agent's full size: its share × deployable at the latest reallocation):
+ *
+ *  - no live agent's full size exceeds (Z × maxAgentShare + (1 − Z) × its
+ *    prior slice) × deployable, the prior slice being an equal share of the
+ *    live agents, capped; a stopped agent's is 0;
+ *  - the whole book's full sizes sum to at most the deployable capital;
+ *  - the bound bites: without credibility (fullCredibilityObs 0) the same
+ *    worlds hand some agent more than it at the first reallocation;
+ *  - credibility moves capital only: every ladder move (CUT, RESTORE,
+ *    STOP_OUT) is the same tick for tick with and without it.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { credibility, defaultCenterBookPolicy, defaultNaivePolicy, runBook, type BookResult, type CenterBookPolicy } from "@allowance/swarm";
+import { makeWorld } from "./arena";
+
+// Research seeds only (< ARENA_EVAL_FLOOR).
+const SEEDS = Array.from({ length: 40 }, (_, i) => i + 1);
+const policy = defaultCenterBookPolicy();
+
+const reallocationTicks = (p: CenterBookPolicy, T: number) =>
+  Array.from({ length: T }, (_, t) => t).filter((t) => t >= p.warmup && (t - p.warmup) % p.rebalanceEvery === 0);
+
+/** Agents stopped out before tick t (the ladder runs at the end of a tick). */
+const stoppedBefore = (b: BookResult, t: number) =>
+  new Set(b.decisions.filter((d) => d.kind === "STOP_OUT" && d.t < t).map((d) => d.node));
+
+const ladderMoves = (b: BookResult) =>
+  b.decisions.filter((d) => d.kind === "CUT" || d.kind === "RESTORE" || d.kind === "STOP_OUT").map((d) => `${d.t} ${d.kind} ${d.node}`);
+
+test("arena: no agent's slot outruns the credibility of its record, and credibility never moves a ladder", async () => {
+  const seen = { worlds: 0, checks: 0, oldBreaches: 0 };
+  for (const seed of SEEDS) {
+    const world = makeWorld(seed);
+    const book = await runBook(world.market, world.swarm(), policy);
+    const old = await runBook(world.market, world.swarm(), { ...policy, fullCredibilityObs: 0 });
+    seen.worlds++;
+    assert.deepEqual(ladderMoves(book), ladderMoves(old), `seed ${seed}: same ladder moves with and without credibility`);
+
+    const T = book.returns.length;
+    for (const t of reallocationTicks(policy, T)) {
+      const navBefore = (b: BookResult) => (t === 0 ? b.startNav : b.nav[t - 1]!);
+      const z = credibility(Math.min(t, policy.recordWindow), policy.fullCredibilityObs);
+      const check = (b: BookResult, strict: boolean) => {
+        const deployable = policy.deploy * Math.min(navBefore(b), b.startNav);
+        const stopped = stoppedBefore(b, t);
+        const live = b.agents.filter((a) => !stopped.has(a.name));
+        const prior = Math.min(policy.maxAgentShare, 1 / live.length);
+        const bound = (z * policy.maxAgentShare + (1 - z) * prior) * deployable;
+        let sum = 0;
+        let breach = false;
+        for (const a of b.agents) {
+          const full = a.fullSize[t]!;
+          if (stopped.has(a.name)) {
+            if (strict) assert.equal(full, 0, `seed ${seed} t ${t}: ${a.name} is stopped`);
+            continue;
+          }
+          sum += full;
+          if (full > bound * (1 + 1e-9)) breach = true;
+          if (strict) {
+            assert.ok(full <= bound * (1 + 1e-9), `seed ${seed} t ${t}: ${a.label} full size ${full.toFixed(0)} > credible bound ${bound.toFixed(0)} (Z ${z.toFixed(2)})`);
+            seen.checks++;
+          }
+        }
+        if (strict) assert.ok(sum <= deployable * (1 + 1e-9), `seed ${seed} t ${t}: the book is not over-allocated`);
+        return breach;
+      };
+      check(book, true);
+      if (t === policy.warmup && check(old, false)) seen.oldBreaches++;
+    }
+  }
+  assert.equal(seen.worlds, SEEDS.length);
+  assert.ok(seen.checks > 5000, `checked ${seen.checks} agent-reallocations`);
+  // The bound is not vacuous: without credibility, a 30-tick record wins more than it in most worlds (38 of 40).
+  assert.ok(seen.oldBreaches >= 30, `without credibility ${seen.oldBreaches} of ${seen.worlds} worlds break the bound at the first reallocation`);
+});
+
+/**
+ * Stopped agents now usually hold capital when they are stopped (a prior
+ * slice, if nothing else), so their stop-outs free real authority. close()
+ * hands it to the pod; the book then hands the pod's slack to the fund in the
+ * same tick. Checked at every tick boundary of every world, for both books.
+ */
+test("arena: a stop-out's capital is back in the fund by the end of its tick; pods hold exactly what they delegate", async () => {
+  const seen = { boundaries: 0, fundedStops: 0 };
+  for (const seed of SEEDS) {
+    const world = makeWorld(seed);
+    for (const p of [policy, defaultNaivePolicy()]) {
+      const spec = world.swarm();
+      const pods = spec.pods.filter((pod) => spec.agents.some((a) => a.pod === pod.label)).map((pod) => `${pod.label}.${spec.fund}`);
+      const check = (tree: BookResult["tree"], t: number) => {
+        for (const pod of pods) {
+          const node = tree.requireNode(pod);
+          assert.equal(node.mandate.budget, node.mandate.spentDirect + tree.reserved(pod), `seed ${seed} ${p.kind} end of tick ${t}: ${pod} holds what it delegates`);
+        }
+        seen.boundaries++;
+      };
+      const book = await runBook(world.market, spec, p, { onTick: (t, tree) => (t > 0 ? check(tree, t - 1) : undefined) });
+      check(book.tree, book.returns.length - 1);
+      seen.fundedStops += book.decisions.filter((d) => d.kind === "STOP_OUT" && !d.detail.includes("already allocated zero")).length;
+    }
+  }
+  assert.ok(seen.fundedStops >= 300, `${seen.fundedStops} stop-outs freed capital`);
+  assert.equal(seen.boundaries, SEEDS.length * 2 * 260, "every tick boundary of every run");
+});
