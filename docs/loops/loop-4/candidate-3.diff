diff --git a/packages/lab/src/arena-unwind.test.ts b/packages/lab/src/arena-unwind.test.ts
new file mode 100644
index 0000000..977b94d
--- /dev/null
+++ b/packages/lab/src/arena-unwind.test.ts
@@ -0,0 +1,60 @@
+/**
+ * Crowd unwinds on randomized arena worlds (research seeds 1–24): for
+ * `unwindCoolOff` ticks from the tick a crowd's viral signal is withdrawn,
+ * no order set the center book marks is net long the crowded name (read from
+ * outside the book, at the trade). The cool-off acts on nothing else: worlds
+ * without a crowd run bit-identical to the book without it, and in crowd
+ * worlds the NAV path is identical up to the unwind. Without the cool-off the
+ * same books are net long the crowded name in some unwinds, so the check can
+ * fail.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { defaultCenterBookPolicy, orderNotional, runBook, type SizedOrder } from "@allowance/swarm";
+import { makeWorld } from "./arena";
+
+const SEEDS = Array.from({ length: 24 }, (_, i) => i + 1);
+const policy = defaultCenterBookPolicy();
+let crowdWorlds = 0;
+let longWithout = 0;
+
+async function run(seed: number, coolOff: number) {
+  const world = makeWorld(seed);
+  const net = new Map<number, number>();
+  const name = world.market.config.crowd.instrument;
+  const book = await runBook(world.market, world.swarm(), { ...policy, unwindCoolOff: coolOff }, {
+    onTrade: (t, _tree, orders: readonly SizedOrder[]) => void net.set(t, orders.reduce((s, o) => s + (orderNotional(o)[name] ?? 0), 0)),
+  });
+  return { world, book, net };
+}
+
+for (const seed of SEEDS) {
+  test(`arena world ${seed}: flat or short the crowded name for the whole cool-off after its crowd unwinds; nothing else moves`, async () => {
+    const on = await run(seed, policy.unwindCoolOff);
+    const off = await run(seed, 0);
+    const { crowd } = on.world.market.config;
+    const withdrawn = on.world.market.ticks.findIndex((k, t) => t > 0 && k.viralSignal === null && on.world.market.ticks[t - 1]!.viralSignal !== null);
+    if (!on.world.meta.crowd) {
+      assert.equal(withdrawn, -1);
+      assert.deepEqual(on.book.returns, off.book.returns, "no crowd: bit-identical");
+      assert.equal(on.book.decisions.filter((d) => d.detail.includes("crowd unwound")).length, 0);
+      return;
+    }
+    crowdWorlds++;
+    assert.equal(withdrawn, crowd.crashTick + 1, "the signal is withdrawn the tick after the crash");
+    assert.deepEqual(on.book.nav.slice(0, withdrawn), off.book.nav.slice(0, withdrawn), "identical up to the unwind");
+    const until = Math.min(withdrawn + policy.unwindCoolOff - 1, on.book.nav.length - 1);
+    for (let t = withdrawn; t <= until; t++) {
+      assert.ok(on.net.get(t)! <= 0.01, `t=${t}: marks ${on.net.get(t)!.toFixed(2)} USDC net long ${crowd.instrument} in the cool-off`);
+      if (off.net.get(t)! > 0.01) longWithout++;
+    }
+    for (const d of on.book.decisions.filter((x) => x.detail.includes("crowd unwound"))) {
+      assert.ok(d.t >= withdrawn && d.t <= until, `unwind cut at t=${d.t} outside the cool-off [${withdrawn}, ${until}]`);
+    }
+  });
+}
+
+test("the arena checks above could fail: without the cool-off some crowd worlds are net long the name in its unwind", () => {
+  assert.ok(crowdWorlds >= 10, `${crowdWorlds} crowd worlds checked`);
+  assert.ok(longWithout > 0, "at least one unwind tick where the book without a cool-off is net long the crowded name");
+});
