+/* ------------------------------------------------------------------ */
+/* 3b. Crowd unwinds                                                  */
+/* ------------------------------------------------------------------ */
+
+/** What the book remembers about the crowd's public signal. */
+export interface UnwindWatch {
+  /** The viral signal published for the last tick seen (null when there was none). */
+  signal: string | null;
+  /**
+   * The crowded name in its cool-off: `from` is the tick its signal was
+   * withdrawn, `until` the last tick of the cool-off (inclusive).
+   */
+  coolOff: { instrument: string; from: number; until: number } | null;
+}
+
+export const NO_UNWIND: UnwindWatch = { signal: null, coolOff: null };
+
+/**
+ * Advance the watch to tick `t`, given the viral signal published for `t`
+ * (`MarketTick.viralSignal`: public before the tick's return, the same
+ * observation every agent gets). A crowd has unwound when the name its signal
+ * pointed to last tick is no longer the signal: that name enters a cool-off
+ * of `coolOffTicks` ticks, t included. A cool-off runs to its end (a new
+ * unwind replaces it), and `coolOffTicks` = 0 never starts one.
+ */
+export function nextUnwindWatch(prev: UnwindWatch, signal: string | null, t: number, coolOffTicks: number): UnwindWatch {
+  let coolOff = prev.coolOff !== null && t <= prev.coolOff.until ? prev.coolOff : null;
+  if (coolOffTicks > 0 && prev.signal !== null && signal !== prev.signal) {
+    coolOff = { instrument: prev.signal, from: t, until: t + coolOffTicks - 1 };
+  }
+  return { signal, coolOff };
+}
+
+/**
+ * If the book is net long `instrument`, the uniform capital scale on the
+ * agents long it that makes the book's net exposure exactly flat: they are
+ * scaled to what the shorts offset (to zero when nobody is short). Agents
+ * short or flat the name are never cut. Null when the book is flat or short.
+ */
+export function unwindBreach(
+  agents: readonly CrowdInput[],
+  instrument: string,
+  nav: number,
+  leverage: number,
+): CrowdBreach | null {
+  if (nav <= 0) return null;
+  const exposure = (m: CrowdInput) => m.capital * leverage * (m.weights[instrument] ?? 0);
+  const members = agents.filter((m) => m.capital > 0 && exposure(m) !== 0);
+  const contributors = members.filter((m) => exposure(m) > 0);
+  const long = contributors.reduce((s, m) => s + exposure(m), 0);
+  const net = members.reduce((s, m) => s + exposure(m), 0);
+  if (!(net > 0) || !(long > 0)) return null;
+  const scale = Math.max(0, Math.min(1, (long - net) / long));
+  return {
+    kind: "UNWIND",
+    members: members.map((m) => m.name),
+    instrument,
+    exposure: net,
+    share: net / nav,
+    limit: 0,
+    scale,
+    contributors: contributors.map((m) => m.name),
+  };
+}
+
 /* ------------------------------------------------------------------ */
 /* 4. Counterparties                                                  */
 /* ------------------------------------------------------------------ */
