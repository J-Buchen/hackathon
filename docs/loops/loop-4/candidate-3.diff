--- /dev/null
+++ b/packages/swarm/src/unwind.test.ts
@@ -0,0 +1,273 @@
+/**
+ * Crowd unwinds (`CenterBookPolicy.unwindCoolOff`). When the public signal a
+ * crowd was following is withdrawn, the crowd has left all at once and forced
+ * sellers keep hitting the name for days after the gap. For `unwindCoolOff`
+ * ticks from the tick the signal is withdrawn, the book is not net long the
+ * crowded name: every agent long it is scaled down by one factor, as a group,
+ * in one tree plan, until the book is flat; shorts are never touched.
+ *
+ * Checked on the pure functions and, from outside the book (the orders it
+ * marks, via `onTrade`), on the generic market's crowd: the guarantee holds on
+ * every tick of the cool-off, the same books without it are net long the name
+ * in its unwind (so these checks can fail), and nothing changes before the
+ * signal is withdrawn.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { pay, type DelegationTree, type PaymentAdapters } from "@allowance/core";
+import { defaultCenterBookPolicy, NO_UNWIND, nextUnwindWatch, unwindBreach, type CrowdInput, type UnwindWatch } from "./allocator";
+import { runBook, tickToUnix, type BookResult, type SwarmSpec } from "./book";
+import { orderNotional, type SizedOrder } from "./gate";
+import { generateMarket, genericMarketConfig } from "./market";
+import { HerdStrategy, MeanReversionStrategy, NoiseStrategy, RogueStrategy, TrendStrategy } from "./strategies";
+
+const watch = (signals: readonly (string | null)[], coolOff: number): UnwindWatch[] => {
+  const out: UnwindWatch[] = [];
+  let w = NO_UNWIND;
+  signals.forEach((s, t) => out.push((w = nextUnwindWatch(w, s, t, coolOff))));
+  return out;
+};
+
+test("unwind watch: a cool-off starts on the tick the signal is withdrawn and lasts exactly coolOff ticks", () => {
+  const signals = [null, null, "MEME", "MEME", "MEME", null, null, null, null, null, null, null];
+  const w = watch(signals, 5);
+  for (let t = 0; t < 5; t++) assert.equal(w[t]!.coolOff, null, `no cool-off while the crowd builds (t=${t})`);
+  for (let t = 5; t <= 9; t++) assert.deepEqual(w[t]!.coolOff, { instrument: "MEME", from: 5, until: 9 }, `t=${t}`);
+  for (let t = 10; t < signals.length; t++) assert.equal(w[t]!.coolOff, null, `over after five ticks (t=${t})`);
+  assert.ok(watch(signals, 0).every((x) => x.coolOff === null), "unwindCoolOff 0 never starts one");
+  assert.ok(watch([null, null, null], 5).every((x) => x.coolOff === null), "no crowd, no cool-off");
+});
+
+test("unwind watch: a signal that moves to another name puts the old one in cool-off; a new unwind replaces a running one", () => {
+  const w = watch(["A", "A", "B", "B", null, null], 3);
+  assert.deepEqual(w[2]!.coolOff, { instrument: "A", from: 2, until: 4 });
+  assert.equal(w[2]!.signal, "B");
+  assert.deepEqual(w[4]!.coolOff, { instrument: "B", from: 4, until: 6 });
+  assert.deepEqual(w[5]!.coolOff, { instrument: "B", from: 4, until: 6 });
+});
+
+test("unwind watch is point-in-time: the watch at t depends on signals up to t only", () => {
+  const past = [null, "X", "X", null, null];
+  const a = watch([...past, "Y", "Y", null], 4);
+  const b = watch([...past, null, "Z", "Z"], 4);
+  assert.deepEqual(a.slice(0, past.length), b.slice(0, past.length));
+});
+
+test("unwind breach: longs scaled by one factor to what the shorts offset; shorts and flat books untouched", () => {
+  const agents: CrowdInput[] = [
+    { name: "dip-buyer", capital: 1_000_000, weights: { MEME: 0.8, GOLD: 0.2 } },
+    { name: "slow-trend", capital: 2_000_000, weights: { MEME: 0.25, GOLD: -0.75 } },
+    { name: "fast-trend", capital: 1_000_000, weights: { MEME: -0.5, GOLD: 0.5 } },
+    { name: "gold-only", capital: 3_000_000, weights: { GOLD: 1 } },
+    { name: "closed", capital: 0, weights: { MEME: 1 } },
+  ];
+  const lev = 2;
+  const b = unwindBreach(agents, "MEME", 10_000_000, lev)!;
+  assert.equal(b.kind, "UNWIND");
+  assert.equal(b.instrument, "MEME");
+  assert.equal(b.limit, 0);
+  // Longs: 1M×2×0.8 + 2M×2×0.25 = 2.6M; short: 1M×2×0.5 = 1M; net 1.6M.
+  assert.ok(Math.abs(b.exposure - 1_600_000) < 1e-6);
+  assert.ok(Math.abs(b.share - 0.16) < 1e-12);
+  assert.deepEqual(b.contributors, ["dip-buyer", "slow-trend"], "only agents long the name, never a short, a flat book or a closed one");
+  assert.deepEqual(b.members, ["dip-buyer", "slow-trend", "fast-trend"]);
+  assert.ok(Math.abs(b.scale - 1 / 2.6) < 1e-12);
+  const after = agents.map((a) => ({ ...a, capital: b.contributors.includes(a.name) ? a.capital * b.scale : a.capital }));
+  const net = after.reduce((s, a) => s + a.capital * lev * (a.weights.MEME ?? 0), 0);
+  assert.ok(Math.abs(net) < 1e-6, `flat after the cut (net ${net})`);
+});
+
+test("unwind breach: no shorts means the longs are cut to zero; flat or net short means no cut", () => {
+  const onlyLong = unwindBreach([{ name: "a", capital: 1_000_000, weights: { MEME: 1 } }], "MEME", 10_000_000, 2)!;
+  assert.equal(onlyLong.scale, 0);
+  assert.equal(
+    unwindBreach(
+      [
+        { name: "a", capital: 1_000_000, weights: { MEME: 0.5 } },
+        { name: "b", capital: 1_000_000, weights: { MEME: -0.5 } },
+      ],
+      "MEME",
+      10_000_000,
+      2,
+    ),
+    null,
+  );
+  assert.equal(unwindBreach([{ name: "b", capital: 1_000_000, weights: { MEME: -1 } }], "MEME", 10_000_000, 2), null);
+  assert.equal(unwindBreach([{ name: "c", capital: 1_000_000, weights: { GOLD: 1 } }], "MEME", 10_000_000, 2), null);
+});
+
+/* ------------------------------------------------------------------ */
+/* The book, on the generic market's crowd in MEME                    */
+/* ------------------------------------------------------------------ */
+
+// Herders ride the viral signal into MEME; a mean-reversion agent buys the
+// dip after the crash; trend and noise agents sit around them.
+function swarm(): SwarmSpec {
+  const all = ["ETH", "BTC", "SOL", "GOLD", "UST10Y", "EURUSD", "MEME"];
+  const crypto = ["ETH", "BTC", "SOL", "MEME"];
+  return {
+    principal: "alice",
+    fund: "fund.eth",
+    aum: 10_000_000,
+    pods: [
+      { label: "systematic", instruments: all },
+      { label: "macro", instruments: ["GOLD", "UST10Y", "EURUSD", "MEME"] },
+      { label: "digital", instruments: crypto },
+    ],
+    agents: [
+      { label: "trend", pod: "systematic", instruments: all, strategy: new TrendStrategy(30) },
+      { label: "herd-a", pod: "systematic", instruments: all, strategy: new HerdStrategy(25) },
+      { label: "meanrev", pod: "macro", instruments: ["GOLD", "UST10Y", "EURUSD", "MEME"], strategy: new MeanReversionStrategy(3) },
+      { label: "herd-b", pod: "macro", instruments: ["GOLD", "UST10Y", "EURUSD", "MEME"], strategy: new HerdStrategy(20) },
+      { label: "noise", pod: "digital", instruments: crypto, strategy: new NoiseStrategy(5) },
+      { label: "herd-c", pod: "digital", instruments: crypto, strategy: new HerdStrategy(15) },
+      { label: "rogue", pod: "digital", instruments: crypto, strategy: new RogueStrategy("GOLD") },
+    ],
+  };
+}
+
+const netIn = (orders: readonly SizedOrder[], name: string) => orders.reduce((s, o) => s + (orderNotional(o)[name] ?? 0), 0);
+
+async function run(seed: number, coolOff: number): Promise<{ book: BookResult; orders: Map<number, SizedOrder[]> }> {
+  const market = generateMarket(genericMarketConfig(seed));
+  const orders = new Map<number, SizedOrder[]>();
+  const book = await runBook(market, swarm(), { ...defaultCenterBookPolicy(), unwindCoolOff: coolOff }, {
+    onTrade: (t, _tree, os) => void orders.set(t, os.map((o) => ({ ...o, weights: { ...o.weights } }))),
+  });
+  return { book, orders };
+}
+
+const unwindCuts = (book: BookResult) => book.decisions.filter((d) => d.kind === "CROWDING_CUT" && d.detail.includes("crowd unwound"));
+
+for (const seed of [7, 9, 11]) {
+  test(`generic market seed ${seed}: never net long the crowded name during its unwind's cool-off, and only then`, async () => {
+    const market = generateMarket(genericMarketConfig(seed));
+    const { crashTick } = market.config.crowd;
+    const coolOff = defaultCenterBookPolicy().unwindCoolOff;
+    assert.equal(coolOff, 5, "on by default: one trading week");
+    // The signal is published through the crash tick and withdrawn the tick after.
+    assert.equal(market.ticks[crashTick]!.viralSignal, "MEME");
+    assert.equal(market.ticks[crashTick + 1]!.viralSignal, null);
+    const from = crashTick + 1;
+    const until = from + coolOff - 1;
+
+    const on = await run(seed, coolOff);
+    const off = await run(seed, 0);
+
+    // Nothing changes before the unwind: same NAV path through the crash.
+    assert.deepEqual(on.book.nav.slice(0, from), off.book.nav.slice(0, from));
+    assert.equal(unwindCuts(off.book).length, 0);
+
+    // Every order set the book marks in the cool-off is flat or short MEME (to a cent).
+    for (let t = from; t <= until; t++) {
+      const net = netIn(on.orders.get(t)!, "MEME");
+      assert.ok(net <= 0.01, `t=${t}: book marks ${net.toFixed(2)} USDC net long MEME during the cool-off`);
+    }
+    // Without the cool-off the same book is net long MEME in the unwind: the check can fail.
+    const longWithout = Math.max(...Array.from({ length: coolOff }, (_, k) => netIn(off.orders.get(from + k)!, "MEME")));
+    assert.ok(longWithout > 0.01 * 10_000_000, `without the cool-off the book is net long MEME in the unwind (${longWithout.toFixed(0)} USDC)`);
+
+    // Unwind cuts happen inside the cool-off only, and name the tick the crowd left.
+    const cuts = unwindCuts(on.book);
+    assert.ok(cuts.length > 0);
+    for (const d of cuts) {
+      assert.ok(d.t >= from && d.t <= until, `unwind cut at t=${d.t} outside [${from}, ${until}]`);
+      assert.match(d.detail, new RegExp(`book net MEME exposure .* crowd unwound at t=${from}, day ${d.t - from + 1} of ${coolOff}: [\\d.]+% of NAV > 0% limit → contributors scaled ×[\\d.]+`));
+    }
+
+    // On the first tick of the unwind both books stand on the same tree until
+    // the cut: agents flat or short MEME keep their authority to the unit, and
+    // every agent long it is scaled by one common factor, in one decision.
+    const a = on.orders.get(from)!;
+    const b = off.orders.get(from)!;
+    const longs = b.filter((o) => (o.weights.MEME ?? 0) > 0 && o.authority > 0).map((o) => o.node);
+    const first = cuts.filter((d) => d.t === from);
+    if (netIn(b, "MEME") > 0.01) {
+      assert.equal(first.length, 1, "one group cut, one plan");
+      assert.deepEqual(first[0]!.node.split(", ").sort(), [...longs].sort());
+      const factors = longs.map((n) => a.find((o) => o.node === n)!.authority / b.find((o) => o.node === n)!.authority);
+      for (const f of factors) assert.ok(Math.abs(f - factors[0]!) < 1e-5, `one factor for the group: ${factors.join(", ")}`);
+    }
+    for (const o of b) {
+      if (longs.includes(o.node)) continue;
+      assert.equal(a.find((x) => x.node === o.node)!.authority, o.authority, `${o.node} is not long MEME: untouched`);
+    }
+  });
+}
+
+test("the cool-off is not a standing cap: a cut agent is sized back up by the first reallocation after it", async () => {
+  const market = generateMarket(genericMarketConfig(7));
+  const { crashTick } = market.config.crowd;
+  const policy = defaultCenterBookPolicy();
+  const { book } = await run(7, policy.unwindCoolOff);
+  const until = crashTick + policy.unwindCoolOff;
+  const cut = new Set(unwindCuts(book).flatMap((d) => d.node.split(", ")));
+  assert.ok(cut.size > 0);
+  const nextRebalance = Array.from({ length: policy.rebalanceEvery }, (_, k) => until + 1 + k).find(
+    (t) => (t - policy.warmup) % policy.rebalanceEvery === 0,
+  )!;
+  const grown = book.decisions.filter((d) => d.t === nextRebalance && d.kind === "REALLOCATE" && cut.has(d.node));
+  assert.ok(grown.length > 0, "a cut agent is resized at the first reallocation after the cool-off");
+  for (const d of grown) {
+    const [from, to] = d.detail.split(" USDC")[0]!.split(" → ").map(Number);
+    assert.ok(to! > from!, `${d.node} is sized back up (${d.detail})`);
+    const i = book.agents.findIndex((a) => a.name === d.node);
+    assert.ok(book.agents[i]!.capital[nextRebalance]! > book.agents[i]!.capital[until]!, "and trades on more authority than in the cool-off");
+  }
+});
+
+/** Always-yes payment ports: this test is about authority, not the adapters. */
+const allowAll: PaymentAdapters = {
+  identity: { verify: async () => ({ ok: true }) },
+  screening: { screen: async () => ({ approved: true }) },
+  settlement: {
+    settle: async (req) => ({
+      settled: true,
+      swapped: false,
+      fromToken: req.payerToken,
+      toToken: req.merchantToken,
+      amountIn: req.amount,
+      amountOut: req.amount,
+    }),
+  },
+};
+
+test("with desks that spend and agents paying out of their own mandates, the cool-off still leaves the book flat or short", async () => {
+  // Cutting a budget by s cuts the authority an order is sized on by at least
+  // s: spent authority and a desk's committed slice are floors, not trading
+  // capital. So the guarantee does not rest on budget = available.
+  const market = generateMarket(genericMarketConfig(7));
+  const { crashTick } = market.config.crowd;
+  const coolOff = defaultCenterBookPolicy().unwindCoolOff;
+  const spec = swarm();
+  for (const a of spec.agents) {
+    a.subMandates = [
+      { label: "exec", share: 0.2 },
+      { label: "data", share: 0.02, instruments: [a.instruments[0]!] },
+    ];
+  }
+  const spend = async (tree: DelegationTree, node: string, merchant: string, amount: bigint, now: number) => {
+    if (tree.isRevokedInChain(node) || tree.available(node) < amount) return;
+    assert.equal((await pay(tree, { node, merchant, amount }, allowAll, { now })).outcome, "SETTLED");
+  };
+  const net = new Map<number, number>();
+  let spentDirect = 0n;
+  const book = await runBook(market, spec, defaultCenterBookPolicy(), {
+    onTick: async (t, tree) => {
+      const now = tickToUnix(t);
+      for (const n of tree.listNodes()) {
+        const label = n.name.split(".")[0];
+        if (label === "exec") await spend(tree, n.name, n.mandate.allowedMerchants![0]!, 2_000_000000n, now);
+        if (label === "data") await spend(tree, n.name, n.mandate.allowedMerchants![0]!, 200_000000n, now);
+      }
+      for (const a of spec.agents) await spend(tree, `${a.label}.${a.pod}.fund.eth`, a.instruments[0]!, 500_000000n, now);
+      spentDirect = spec.agents.reduce((s, a) => s + tree.requireNode(`${a.label}.${a.pod}.fund.eth`).mandate.spentDirect, 0n);
+    },
+    onTrade: (t, _tree, orders) => void net.set(t, netIn(orders, "MEME")),
+  });
+  assert.ok(spentDirect > 0n, "agents did spend out of their own mandates");
+  assert.ok(unwindCuts(book).length > 0, "the unwind cut fired");
+  for (let t = crashTick + 1; t <= crashTick + coolOff; t++) {
+    assert.ok(net.get(t)! <= 0.01, `t=${t}: marks ${net.get(t)!.toFixed(2)} USDC net long MEME during the cool-off`);
+  }
+});
