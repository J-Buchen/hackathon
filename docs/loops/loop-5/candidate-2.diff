+test("allocate: scores read the market over the record window only, and exactly the record's ticks", () => {
+  const long = N + 100;
+  const m = series(20, long, 0.001, 0.01);
+  const a = series(21, long, 0.0006, 0.01).map((v, i) => v + m[i]!);
+  const b = series(22, long, 0.0003, 0.01);
+  const out = allocate([agent("a", a), agent("b", b)], 1_000_000, policy, m);
+  // Changing the market BEFORE the window changes nothing.
+  const early = m.map((v, i) => (i < long - policy.recordWindow ? v + 0.05 : v));
+  const again = allocate([agent("a", a), agent("b", b)], 1_000_000, policy, early);
+  assert.deepEqual(again, out);
+  // The window's score is the appraisal ratio of the window.
+  const w = policy.recordWindow;
+  const expected = sharpe(marketResidual(a.slice(-w), m.slice(-w)).residual) * (w / (w + policy.shrinkageObs));
+  assert.ok(Math.abs(out.find((s) => s.name === "a")!.shrunkSharpe - expected) < 1e-12);
+  // A market series not aligned with the records is refused, not silently re-aligned.
+  assert.throws(() => allocate([agent("a", a), agent("b", b)], 1_000_000, policy, m.slice(1)), RangeError);
