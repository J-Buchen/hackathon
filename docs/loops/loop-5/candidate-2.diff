+  const rawPlain = allocate([agent("edge", edge), agent("other", other)], 1_000_000, { ...policy, score: "total" }, rally);
+  const rawLevered = allocate([agent("edge", edge.map((v, i) => v + 1.5 * rally[i]!)), agent("other", other)], 1_000_000, { ...policy, score: "total" }, rally);
+  assert.ok(Math.abs(rawPlain[0]!.shrunkSharpe - rawLevered[0]!.shrunkSharpe) > 0.1);
