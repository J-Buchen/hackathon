--- /dev/null
+++ b/packages/swarm/src/attribution.test.ts
@@ -0,0 +1,265 @@
+/**
+ * (A) Records are scored on what the market does not explain. An agent is
+ * paid (in capital) for its alpha, not for the market's run while it held
+ * beta. Each test names the guarantee it pins and fails if it breaks.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { allocate, defaultCenterBookPolicy, type AgentScoreInput, type CenterBookPolicy } from "./allocator";
+import { runBook, type BookResult, type SwarmSpec } from "./book";
+import type { SizedOrder } from "./gate";
+import { generateMarket, genericMarketConfig, type Market } from "./market";
+import { gaussian, mulberry32 } from "./rng";
+import { equalWeightReturn, marketResidual, mean, sharpe } from "./stats";
+import { NoiseStrategy, type Strategy, type Weights } from "./strategies";
+
+const series = (seed: number, n: number, drift: number, vol: number) => {
+  const z = gaussian(mulberry32(seed));
+  return Array.from({ length: n }, () => drift + vol * z());
+};
+
+/* ------------------------------------------------------------------ */
+/* The single-index split                                             */
+/* ------------------------------------------------------------------ */
+
+test("marketResidual: recovers beta, keeps the alpha, and ignores any market exposure added to a record", () => {
+  const m = series(1, 250, 0.001, 0.01);
+  const e = series(2, 250, 0.0004, 0.008);
+  const y = e.map((v, i) => v + 1.7 * m[i]!);
+  const { beta, residual } = marketResidual(y, m);
+  // OLS of y on m: the slope is 1.7 plus e's sample covariance with m.
+  const cov = mean(e.map((v, i) => (v - mean(e)) * (m[i]! - mean(m))));
+  const varM = mean(m.map((v) => (v - mean(m)) ** 2));
+  assert.ok(Math.abs(beta - (1.7 + cov / varM)) < 1e-9, `beta ${beta}`);
+  // The residual keeps the intercept: its mean is the record's alpha.
+  assert.ok(Math.abs(mean(residual) - (mean(y) - beta * mean(m))) < 1e-12);
+  // Adding k × market to a record moves its beta by k and leaves the residual as it was.
+  for (const k of [-2, 0.5, 3]) {
+    const shifted = marketResidual(y.map((v, i) => v + k * m[i]!), m);
+    assert.ok(Math.abs(shifted.beta - (beta + k)) < 1e-9);
+    shifted.residual.forEach((r, i) => assert.ok(Math.abs(r - residual[i]!) < 1e-12, `tick ${i}`));
+  }
+});
+
+test("marketResidual: a flat market explains nothing; misaligned series are refused", () => {
+  const y = series(3, 50, 0.001, 0.01);
+  const flat = marketResidual(y, y.map(() => 0.002));
+  assert.equal(flat.beta, 0);
+  assert.deepEqual(flat.residual, y);
+  assert.deepEqual(marketResidual([0.01], [0.02]), { beta: 0, residual: [0.01] });
+  assert.throws(() => marketResidual(y, y.slice(1)), RangeError);
+});
+
+test("equalWeightReturn: the mean over the universe, a missing instrument counting as flat", () => {
+  assert.equal(equalWeightReturn({ A: 0.02, B: -0.01, C: 0.05 }, ["A", "B", "C"]), 0.02);
+  assert.equal(equalWeightReturn({ A: 0.03 }, ["A", "B", "C"]), 0.01);
+  assert.equal(equalWeightReturn({ A: 0.03 }, []), 0);
+});
+
+/* ------------------------------------------------------------------ */
+/* allocate                                                            */
+/* ------------------------------------------------------------------ */
+
+const policy: CenterBookPolicy = { ...defaultCenterBookPolicy(), maxAgentShare: 1 };
+const N = 250;
+// A year in which the market rallied: +0.1% a tick on average, at 1% vol.
+const rally = series(10, N, 0.001, 0.01);
+const agent = (name: string, unitReturns: readonly number[]): AgentScoreInput => ({ name, unitReturns, stopped: false, ladderMultiplier: 1 });
+const shareOf = (out: ReturnType<typeof allocate>, name: string) => out.find((s) => s.name === name)!.share;
+
+test("allocate: alpha is the default score", () => {
+  assert.equal(defaultCenterBookPolicy().score, "alpha");
+});
+
+test("allocate: a record that is the market's run earns no capital for it; the record the market cannot explain does", () => {
+  // Square waves of periods 2, 4 and 8 are exactly uncorrelated over 256 ticks,
+  // so every slope and residual below is known in closed form.
+  const wave = (period: number, i: number) => (i % period < period / 2 ? 1 : -1);
+  const n = 256;
+  // The market rallied: +0.2% a tick at 1% vol (annual Sharpe ≈ 3.2).
+  const market = Array.from({ length: n }, (_, i) => 0.002 + 0.01 * wave(2, i));
+  // `beta`: long the market at 2× plus zero-mean noise of its own. Its raw
+  // record (annual Sharpe ≈ 3.0) is all rally: its alpha is exactly zero.
+  const beta = market.map((m, i) => 2 * m + 0.006 * wave(4, i));
+  // `alpha`: market-neutral, a real but smaller edge (annual Sharpe ≈ 1.3).
+  const alpha = Array.from({ length: n }, (_, i) => 0.0008 + 0.01 * wave(8, i));
+  const agents = [agent("beta", beta), agent("alpha", alpha)];
+  assert.ok(sharpe(beta) > 2 * sharpe(alpha), "raw Sharpe ranks the beta record first, by far");
+
+  const total = allocate(agents, 1_000_000, { ...policy, score: "total" }, market);
+  const scored = allocate(agents, 1_000_000, policy, market);
+  assert.ok(shareOf(total, "beta") > 0.6, `scored raw, the rally wins the book (${shareOf(total, "beta").toFixed(2)})`);
+  assert.ok(shareOf(scored, "beta") < 1e-9, `scored on alpha, the rally is the market's, not the agent's (${shareOf(scored, "beta")})`);
+  assert.ok(shareOf(scored, "alpha") > 1 - 1e-9);
+  const b = scored.find((s) => s.name === "beta")!;
+  assert.ok(Math.abs(b.beta - 2) < 1e-9, `its beta is measured (${b.beta})`);
+  assert.ok(Math.abs(scored.find((s) => s.name === "alpha")!.beta) < 1e-9);
+  assert.equal(total.find((s) => s.name === "beta")!.beta, 0, "a raw score reports no beta");
+});
+
+test("allocate: two records that differ only by market exposure score the same", () => {
+  const edge = series(13, N, 0.0008, 0.01);
+  const other = series(14, N, 0.0005, 0.01);
+  const plain = allocate([agent("edge", edge), agent("other", other)], 1_000_000, policy, rally);
+  const levered = allocate([agent("edge", edge.map((v, i) => v + 1.5 * rally[i]!)), agent("other", other)], 1_000_000, policy, rally);
+  const shorted = allocate([agent("edge", edge.map((v, i) => v - 0.8 * rally[i]!)), agent("other", other)], 1_000_000, policy, rally);
+  for (const out of [levered, shorted]) {
