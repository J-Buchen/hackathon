+/**
+ * The market's return on one tick: the equal-weighted mean of `returns` over
+ * `instruments` (a missing instrument counts as flat). The broadest index of
+ * a universe that can be built without market capitalizations.
+ */
+export function equalWeightReturn(returns: Readonly<Record<string, number>>, instruments: readonly string[]): number {
+  if (instruments.length === 0) return 0;
+  let s = 0;
+  for (const k of instruments) s += returns[k] ?? 0;
+  return s / instruments.length;
+}
+
+/**
+ * Split a return series into what the market explains and what it does not
+ * (single-index model, OLS with intercept): `beta` is the slope of `y` on the
+ * market `x` over the same ticks, and `residual[i] = y[i] − beta · x[i]`, the
+ * alpha plus the idiosyncratic noise. The residual keeps the intercept, so its
+ * mean is the record's alpha and its Sharpe is the appraisal ratio. Adding any
+ * multiple of `x` to `y` changes `beta` and nothing else. beta = 0 (residual =
+ * y) when the market did not move or the series are shorter than two ticks.
+ */
+export function marketResidual(y: readonly number[], x: readonly number[]): { beta: number; residual: number[] } {
+  if (y.length !== x.length) throw new RangeError(`marketResidual: ${y.length} returns vs ${x.length} market ticks`);
+  const n = y.length;
+  // A market that did not move explains nothing (tested exactly: a constant's
+  // floating-point mean can leave dust deviations that would fit a spurious slope).
+  if (n < 2 || x.every((v) => v === x[0])) return { beta: 0, residual: [...y] };
+  const mx = mean(x);
+  const my = mean(y);
+  let sxy = 0;
+  let sxx = 0;
+  for (let i = 0; i < n; i++) {
+    sxy += (x[i]! - mx) * (y[i]! - my);
+    sxx += (x[i]! - mx) * (x[i]! - mx);
+  }
+  const beta = sxx > 0 ? sxy / sxx : 0;
+  return { beta, residual: y.map((v, i) => v - beta * x[i]!) };
+}
