+/* ------------------------------------------------------------------ */
+/* The book                                                           */
+/* ------------------------------------------------------------------ */
+
+/**
+ * The seed-7 generic market with a scripted market factor on top: every
+ * instrument gets the same f(t) (a rally: +0.1% a tick on average at 1% vol),
+ * and EURUSD alone an edge of its own (+0.15% a tick). Scripting the market
+ * rather than the agents keeps every agent point-in-time.
+ */
+function rallyMarket(): Market {
+  const m = generateMarket(genericMarketConfig(7));
+  const f = series(40, m.ticks.length, 0.001, 0.01);
+  m.ticks.forEach((tick, t) => {
+    for (const k of m.instruments) tick.returns[k] = tick.returns[k]! + f[t]! + (k === "EURUSD" ? 0.0015 : 0);
+  });
+  return m;
+}
+
+/** Long every instrument but EURUSD, equally: the market, give or take. */
+class LongMarket implements Strategy {
+  readonly style = "long-market";
+  decide(): Weights {
+    return { ETH: 1 / 6, BTC: 1 / 6, SOL: 1 / 6, GOLD: 1 / 6, UST10Y: 1 / 6, MEME: 1 / 6 };
+  }
+}
+
+/** Long EURUSD against GOLD: market-neutral, holding the one real edge. */
+class Pair implements Strategy {
+  readonly style = "pair";
+  decide(): Weights {
+    return { EURUSD: 0.5, GOLD: -0.5 };
+  }
+}
+
+function roster(): SwarmSpec {
+  const all = ["ETH", "BTC", "SOL", "GOLD", "UST10Y", "EURUSD", "MEME"];
+  return {
+    principal: "alice",
+    fund: "fund.eth",
+    aum: 10_000_000,
+    pods: [{ label: "systematic", instruments: all }],
+    agents: [
+      { label: "long-market", pod: "systematic", instruments: all, strategy: new LongMarket() },
+      { label: "pair", pod: "systematic", instruments: all, strategy: new Pair() },
+      { label: "noise", pod: "systematic", instruments: all, strategy: new NoiseStrategy(5) },
+    ],
+  };
+}
+
+const avgCapital = (b: BookResult, label: string) => mean(b.agents.find((a) => a.label === label)!.capital.slice(60));
+// Scoring alone: no per-agent cap (three capped agents would all sit at the cap
+// whatever their scores) and no crowding limits (the pair's EURUSD leg would
+// otherwise breach the book's single-instrument limit).
+const isolated: CenterBookPolicy = { ...defaultCenterBookPolicy(), maxAgentShare: 1, crowdMaxShare: 1e9, bookMaxShare: 1e9 };
+
+test("book: the market series it scores against is the equal-weighted return of the fund's universe, tick by tick", async () => {
+  const market = rallyMarket();
+  const book = await runBook(market, roster(), defaultCenterBookPolicy());
+  assert.equal(book.marketReturns.length, market.ticks.length);
+  book.marketReturns.forEach((r, t) => {
+    const want = market.instruments.reduce((s, k) => s + market.ticks[t]!.returns[k]!, 0) / market.instruments.length;
+    assert.ok(Math.abs(r - want) < 1e-15, `tick ${t}`);
+  });
+  for (const a of book.agents) assert.equal(a.unitReturns.length, book.marketReturns.length, "aligned with every record");
+});
+
+test("book: in a rally, the center book moves capital from the agent riding the market to the one with alpha", async () => {
+  const market = rallyMarket();
+  const alpha = await runBook(market, roster(), isolated);
+  const total = await runBook(market, roster(), { ...isolated, score: "total" });
+  const lm = alpha.agents.find((a) => a.label === "long-market")!;
+  assert.ok(sharpe(lm.unitReturns) > 1, "the market rider's raw record looks skilled");
+  assert.ok(
+    avgCapital(alpha, "long-market") < 0.5 * avgCapital(total, "long-market"),
+    `market rider: ${avgCapital(alpha, "long-market").toFixed(0)} scored on alpha vs ${avgCapital(total, "long-market").toFixed(0)} raw`,
+  );
+  assert.ok(avgCapital(alpha, "pair") > avgCapital(total, "pair"), "the alpha agent gets the capital");
+  // The book's decisions say what it scored.
+  const d = alpha.decisions.find((x) => x.kind === "REALLOCATE" && x.node === lm.name);
+  assert.ok(d, "the market rider is resized");
+  assert.match(d!.detail, /alpha sharpe -?\d+\.\d+ net of beta \d+\.\d+/);
+  assert.ok(total.decisions.filter((x) => x.kind === "REALLOCATE").every((x) => !x.detail.includes("alpha")));
+});
+
+test("book: point-in-time — everything that sizes tick t's trades reads the market only through t − 1", async () => {
+  const k = 150;
+  const policy = isolated;
+  // Tick k is a scheduled reallocation: its targets are scored on records and
+  // the market through k − 1, then its crowding check runs, then it trades.
+  assert.equal((k - policy.warmup) % policy.rebalanceEvery, 0);
+  const base = rallyMarket();
+  const future = rallyMarket();
+  // Rewrite every return from tick k on: a crash in the market factor.
+  future.ticks.forEach((tick, t) => {
+    if (t >= k) for (const s of future.instruments) tick.returns[s] = tick.returns[s]! - 0.03;
+  });
+  const watch = (into: SizedOrder[][]) => ({
+    onTrade: (t: number, _tree: unknown, orders: readonly SizedOrder[]) => {
+      into[t] = structuredClone([...orders]);
+    },
+  });
+  const oa: SizedOrder[][] = [];
+  const ob: SizedOrder[][] = [];
+  const a = await runBook(base, roster(), policy, watch(oa));
+  const b = await runBook(future, roster(), policy, watch(ob));
+  assert.deepEqual(b.marketReturns.slice(0, k), a.marketReturns.slice(0, k));
+  assert.deepEqual(ob.slice(0, k + 1), oa.slice(0, k + 1), "every order through tick k is sized exactly as before");
+  // The ladder and operator caps move at tick k's close, on tick k's own return.
+  const atClose = new Set(["CUT", "RESTORE", "STOP_OUT", "OPERATOR_CUT", "OPERATOR_RESTORE"]);
+  const before = (r: BookResult) => r.decisions.filter((d) => d.t < k || (d.t === k && !atClose.has(d.kind)));
+  assert.deepEqual(before(b), before(a), "so is every decision before tick k's close");
+  assert.notDeepEqual(ob.slice(k + 1), oa.slice(k + 1), "the rewritten future does change later orders");
+  // …and the allocator reads it: the first reallocation after the crash resizes differently.
+  const next = (r: BookResult) => r.decisions.filter((d) => d.kind === "REALLOCATE" && d.t === k + policy.rebalanceEvery);
+  assert.notDeepEqual(next(b), next(a));
+});
