+  }
+  assert.equal(tree.isClosed(DOOMED), true);
+  assert.ok(tree.requireNode(`exec.${DOOMED}`).mandate.spentDirect > 0n);
+  assert.ok(tree.requireNode(`data.${DOOMED}`).mandate.spentDirect > 0n);
