+    const cuts = book.decisions.filter((d) => d.kind === "CUT");
+    if (policy.kind === "center" && policy.ddCut !== undefined) assert.ok(cuts.some((d) => d.node === DOOMED));
+    else assert.deepEqual(cuts, []);
+  });
