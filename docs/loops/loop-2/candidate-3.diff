+/**
+ * Put capital that cuts and crowding caps took away back to work, by score.
+ *
+ * A drawdown cut or a crowding cap is aimed at ONE agent or ONE crowded
+ * trade; holding what it frees in cash also shrinks every other position the
+ * fund holds, so the fund pays for fixing one concentration with its whole
+ * diversified book. Here the freed capital goes to the agents that can still
+ * grow, in proportion to their `allocate` shares (water-filling: an agent
+ * that reaches its ceiling is pinned there and the rest is shared among the
+ * others), until the targets add up to `deployable` or every grower is at
+ * its ceiling; only then does the remainder stay in cash.
+ *
+ *   - Cut agents (`ladderMultiplier` < 1), crowd-capped agents at their cap,
+ *     stopped agents and agents with no share never grow: every cut stands.
+ *   - No agent grows past `maxAgentShare` × `deployable` or its crowding cap.
+ *   - No target ever falls, and targets never sum above `deployable`
+ *     (up to float rounding).
+ */
+export function redeploy(
+  scores: readonly AgentScore[],
+  inputs: readonly AgentScoreInput[],
+  deployable: number,
+  policy: Pick<CenterBookPolicy, "maxAgentShare">,
+): AgentScore[] {
+  const input = new Map(inputs.map((a) => [a.name, a]));
+  const cur = scores.map((s) => s.target);
+  const ceiling = scores.map((s, i) => {
+    const a = input.get(s.name);
+    if (!a || a.stopped || s.share <= 0 || a.ladderMultiplier < 1) return cur[i]!;
+    return Math.max(cur[i]!, Math.min(policy.maxAgentShare * deployable, a.crowdCap ?? Infinity));
+  });
+  let room = deployable - cur.reduce((x, y) => x + y, 0);
+  const free = new Set<number>();
+  scores.forEach((s, i) => {
+    if (ceiling[i]! > cur[i]!) free.add(i);
+  });
+  // Each pass either hands out all the room or pins at least one agent.
+  while (room > 1e-9 * Math.max(1, deployable) && free.size > 0) {
+    let weight = 0;
+    for (const i of free) weight += scores[i]!.share;
+    const pinned = [...free].filter((i) => cur[i]! + (room * scores[i]!.share) / weight >= ceiling[i]!);
+    if (pinned.length === 0) {
+      for (const i of free) cur[i] = cur[i]! + (room * scores[i]!.share) / weight;
+      room = 0;
+      break;
+    }
+    for (const i of pinned) {
+      room -= ceiling[i]! - cur[i]!;
+      cur[i] = ceiling[i]!;
+      free.delete(i);
+    }
+  }
+  return scores.map((s, i) => ({ ...s, target: cur[i]!, redeployed: cur[i]! - s.target }));
+}
