+test("redeploy: across random books, no target falls, every cut stands, no ceiling is crossed, and cash is left only when nobody can grow", () => {
+  const u = mulberry32(42);
+  for (let trial = 0; trial < 500; trial++) {
+    const n = 1 + Math.floor(u() * 12);
+    const D = 1_000_000 * (0.1 + u());
+    const maxAgentShare = 0.1 + 0.9 * u();
+    const raw = Array.from({ length: n }, () => (u() < 0.3 ? 0 : u()));
+    const shares = capShares(raw, maxAgentShare);
+    const inputs = shares.map((_, i) => ({
+      name: `a${i}`,
+      unitReturns: [],
+      stopped: u() < 0.1,
+      ladderMultiplier: u() < 0.25 ? 0.5 : 1,
+      crowdCap: u() < 0.3 ? u() * 0.3 * D : undefined,
+    }));
+    const scores = shares.map((share, i) => {
+      const a = inputs[i]!;
+      let target = a.stopped ? 0 : share * D * a.ladderMultiplier;
+      if (a.crowdCap !== undefined) target = Math.min(target, a.crowdCap);
+      return { name: a.name, sharpe: 0, shrunkSharpe: 0, vol: 0, multiplicity: 1, share: a.stopped ? 0 : share, target };
