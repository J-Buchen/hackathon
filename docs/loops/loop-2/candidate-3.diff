+function growWithin(tree: DelegationTree, asks: ReadonlyMap<string, bigint>): void {
+  const byParent = new Map<string, [string, bigint][]>();
+  for (const [name, ask] of asks) {
+    const node = tree.requireNode(name);
+    if (node.parent === null || tree.isRevokedInChain(name) || ask <= node.mandate.budget) continue;
+    const list = byParent.get(node.parent);
