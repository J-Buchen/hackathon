+/* Crowding measured beyond the lead counterparty (`crowdBeyondLead`). */
+
+const NAV = 10_000_000;
+const LEAD = { crowdSimilarity: 0.8, crowdMaxShare: 0.1, bookMaxShare: 0.2, crowdBeyondLead: true };
+/** A group's exposure to `k` stacked beyond its lead counterparty's exemption. */
+const beyondLead = (group: readonly CrowdInput[], k: string, lev = 2) => {
+  const e = group.reduce((s, m) => s + m.capital * lev * (m.weights[k] ?? 0), 0);
+  return Math.abs(e) - (leadCounterparty(group, k, Math.sign(e), lev)?.exempt ?? 0);
