+test("crowding beyond the lead: every breach is solved exactly, and a split position never trips it", () => {
+  const u = mulberry32(2024);
+  const names = ["A", "B", "C", "D"];
+  const seen = { CLONES: 0, BOOK: 0, cut: 0 };
+  for (let trial = 0; trial < 300; trial++) {
+    const n = 2 + Math.floor(u() * 7);
+    const agents: CrowdInput[] = Array.from({ length: n }, (_, i) => {
+      const w: Record<string, number> = {};
+      if (u() < 0.3) w[names[Math.floor(u() * 4)]!] = u() < 0.8 ? 1 : -1; // all-in
+      else for (const k of names) if (u() < 0.6) w[k] = u() - 0.4;
+      const g = Object.values(w).reduce((s, x) => s + Math.abs(x), 0);
+      for (const k of Object.keys(w)) w[k] = w[k]! / Math.max(1, g);
+      return { name: `ag${i}`, operator: `op-${Math.floor(u() * 3)}`, capital: 200_000 + u() * 2_800_000, weights: w };
+    });
