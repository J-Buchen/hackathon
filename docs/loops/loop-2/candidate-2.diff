+    { name: "desk.pod2", operator: "op-7", capital: 2_000_000, weights: { COFFEE: 0.5, TEA: -0.5 } },
+  ];
+  const s = scanCrowding(split, NAV, 2, LEAD);
+  assert.deepEqual(s.clusters, [["picker.pod1", "desk.pod2"]]);
+  assert.deepEqual(s.breaches, []);
