+
+test("crowding beyond the lead: running one trade at full size under more names buys no room", () => {
+  // Two names of one operator, each all-in: the exemption is what ONE of them
+  // could hold at full size, so the second name's 4M is a crowd of one operator.
+  const clones: CrowdInput[] = [
+    { name: "x1", operator: "op-1", capital: 2_000_000, weights: { COFFEE: 1 } },
+    { name: "x2", operator: "op-1", capital: 2_000_000, weights: { COFFEE: 1 } },
+  ];
