+  // One agent all-in: 60% of NAV in one name. The plain book limit cuts it;
+  // beyond its own position there is nothing stacked, so no crowd.
+  const alone: CrowdInput[] = [{ name: "a", capital: 3_000_000, weights: { COFFEE: 1 } }];
