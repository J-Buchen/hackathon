+/** Each agent's ladder state after every tick, replayed from its OWN record alone (no book, no capital, no siblings). */
+function ownLadders(book: BookResult): Map<string, LadderState[]> {
+  const policy = defaultCenterBookPolicy();
+  const out = new Map<string, LadderState[]>();
+  for (const a of book.agents) {
+    let state: LadderState = "active";
+    const states: LadderState[] = [];
+    for (let t = 0; t < a.unitReturns.length; t++) {
+      const record = a.unitReturns.slice(0, t + 1);
+      const rungs = scaleLadder(record, {
+        ddStop: policy.ddStop,
+        ddCut: policy.ddCut,
+        ddRecover: policy.ddRecover,
+        ddStopVol: policy.ddStopVol,
+        volWindow: policy.window,
+      });
+      state = nextLadderState(state, record, rungs);
+      states.push(state);
+    }
+    out.set(a.name, states);
+  }
+  return out;
