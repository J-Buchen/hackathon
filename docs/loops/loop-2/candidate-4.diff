+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { defaultCenterBookPolicy, runBook, type BookResult } from "@allowance/swarm";
+import { makeWorld } from "./arena";
+
+// Research seeds only (< ARENA_EVAL_FLOOR).
+const SEEDS = Array.from({ length: 40 }, (_, i) => i + 1);
+
+const stopOuts = (b: BookResult) => b.decisions.filter((d) => d.kind === "STOP_OUT").map((d) => [d.t, d.node]);
+
+test("arena: operators are one counterparty, and no agent's own stop-out is ever delayed or advanced by it", async () => {
+  let worlds = 0;
+  let groupCuts = 0;
+  for (const seed of SEEDS) {
+    const world = makeWorld(seed);
+    if (world.meta.sharedOperators === 0) continue;
+    worlds++;
+    const spec = world.swarm();
+    const labelled = await runBook(world.market, spec, defaultCenterBookPolicy());
+    const unlabelled = world.swarm();
+    const blind = await runBook(
+      world.market,
+      { ...unlabelled, agents: unlabelled.agents.map((a) => ({ ...a, operator: undefined })) },
+      defaultCenterBookPolicy(),
+    );
+    assert.deepEqual(stopOuts(labelled), stopOuts(blind), `seed ${seed}: stop-outs move with operator labels`);
+
+    const operatorOf = new Map(labelled.agents.map((a, i) => [a.name, spec.agents[i]!.operator]));
+    const stoppedAt = new Map(stopOuts(labelled).map(([t, n]) => [n as string, t as number]));
+    for (const cut of labelled.decisions.filter((d) => d.kind === "OPERATOR_CUT")) {
+      groupCuts++;
+      // A cut follows a stop-out of ANOTHER name of the same operator on the same tick…
+      const cause = [...stoppedAt].find(([n, t]) => t === cut.t && n !== cut.node && operatorOf.get(n) === operatorOf.get(cut.node));
+      assert.ok(cause, `seed ${seed}: ${cut.node} cut at ${cut.t} without a stopped sibling`);
+      // …and never revokes the name it cuts: only its own record can.
+      const own = stoppedAt.get(cut.node);
+      assert.ok(own === undefined || own > cut.t, `seed ${seed}: ${cut.node} stopped by its operator, not its record`);
+    }
+    for (const n of labelled.tree.listNodes()) assert.ok(labelled.tree.available(n.name) >= 0n);
+    assert.ok(!labelled.tree.events.some((e) => e.result === "ATTENUATION_REJECTED"));
+  }
+  assert.ok(worlds >= 20, `enough worlds with shared operators (${worlds})`);
+  assert.ok(groupCuts > 0, "the group cut is exercised");
+});
