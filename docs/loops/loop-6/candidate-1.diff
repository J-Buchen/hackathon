+      const is = bucket.map((n) => n.name);
+      const says = (replayed.childrenIndex_.get(parent) ?? []).map((n) => n.name);
+      const stray = bucket.some((n) => this.nodes_.get(n.name) !== n);
+      if (stray || !sameList(is, says)) {
