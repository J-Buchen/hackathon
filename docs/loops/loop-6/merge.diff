+  const renamed = await built();
+  renamed.requireNode(B).name = "c.pod.fund.eth";
+  assert.deepEqual(kinds(renamed.verifyAgainstLog()), [`UNLOGGED_WRITE ${B}`, `UNLOGGED_WRITE ${POD}`]);
